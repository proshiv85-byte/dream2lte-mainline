# Development additions (DEV=1 ./build.sh): verbose log, USB debug messages
# and the ARMtix bring-up wrapper (rootfs/init-wrapper) as init.
CONFIG_CMDLINE="console=tty0 loglevel=7 panic=3 printk.time=1 pstore.compress=none clk_ignore_unused pd_ignore_unused dwc3.dyndbg=+p dwc3_exynos.dyndbg=+p phy_exynos5_usbdrd.dyndbg=+p d2l.init=/root/mainline/init-wrapper"
