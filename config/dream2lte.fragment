CONFIG_ARCH_EXYNOS=y
CONFIG_LOCALVERSION="-dream2lte"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CMDLINE="console=tty0 loglevel=4 panic=10 pstore.compress=none clk_ignore_unused pd_ignore_unused"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_KEYBOARD_GPIO=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=3
# CONFIG_MODULE_SIG is not set
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
# CONFIG_SCSI_UFS_CRYPTO is not set
CONFIG_PHY_SAMSUNG_UFS=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_INPUT_UINPUT=y
CONFIG_ZSWAP=y
CONFIG_CRYPTO_LZ4=y
CONFIG_FUSE_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_USER_NS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_ETH=n
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_TYPEC=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_I2C_CHARDEV=y
CONFIG_BATTERY_MAX17042=y

CONFIG_REGULATOR_S2MPS17=y
CONFIG_TOUCHSCREEN_STMFTS=y
CONFIG_RTC_DRV_S2MPS17=y
CONFIG_CHARGER_MAX77865=y
CONFIG_PCIE_EXYNOS8895=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_CMA_SIZE_MBYTES=256
CONFIG_DRM_EXYNOS8895_DECON=y
# CONFIG_DRM_EXYNOS5433_DECON is not set
# CONFIG_DRM_EXYNOS7_DECON is not set
# CONFIG_DRM_EXYNOS_DSI is not set
# CONFIG_DRM_EXYNOS_HDMI is not set
