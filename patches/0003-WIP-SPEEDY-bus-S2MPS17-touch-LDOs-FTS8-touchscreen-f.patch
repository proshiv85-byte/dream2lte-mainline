diff --git a/drivers/i2c/busses/i2c-exynos-speedy.c b/drivers/i2c/busses/i2c-exynos-speedy.c
new file mode 100644
index 000000000..c81ddf1e6
--- /dev/null
+++ b/drivers/i2c/busses/i2c-exynos-speedy.c
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos SPEEDY (Serial Protocol in an EffEctive Digital waY) driver
+ *
+ * SPEEDY is the single-wire bus between Exynos SoCs and their Samsung PMICs.
+ * It is shared with the APM (power management) core, so all accesses go
+ * through the "IP batcher" in front of the controller, which takes the
+ * hardware semaphore around each transaction.
+ *
+ * A SPEEDY address has 12 bits: the upper 4 bits select a block of the PMIC
+ * (top, PMIC, RTC, ...), the lower 8 bits are the register. This driver maps
+ * the block to the I2C client address and expects the register as the first
+ * written byte, so that regmap-i2c and the SMBus byte/block accessors work:
+ *
+ *   write: [reg, data...]          -> SPEEDY write to (addr << 8 | reg)
+ *   read:  [reg] + read of n bytes -> SPEEDY read from (addr << 8 | reg)
+ *
+ * Based on the Samsung vendor driver by Youngmin Nam <youngmin.nam@samsung.com>.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+/* SPEEDY registers */
+#define SPEEDY_CTRL			0x000
+#define SPEEDY_FIFO_CTRL		0x004
+#define SPEEDY_CMD			0x008
+#define SPEEDY_INT_ENABLE		0x00c
+#define SPEEDY_INT_STATUS		0x010
+#define SPEEDY_TX_DATA			0x034
+#define SPEEDY_RX_DATA			0x038
+
+#define SPEEDY_CTRL_RESET_VAL		0x30050
+#define SPEEDY_ENABLE			BIT(0)
+#define SPEEDY_REMOTE_RESET_REQ		BIT(30)
+#define SPEEDY_SW_RST			BIT(31)
+
+#define SPEEDY_RX_TRIGGER_LEVEL(x)	((x) << 0)
+#define SPEEDY_TX_TRIGGER_LEVEL(x)	((x) << 8)
+#define SPEEDY_FIFO_RESET		BIT(31)
+
+#define SPEEDY_BURST_LENGTH(x)		((x) << 0)
+#define SPEEDY_BURST_INCR		(1 << 5)
+#define SPEEDY_ADDRESS(x)		(((x) & 0xfff) << 7)
+#define SPEEDY_ACCESS_RANDOM		BIT(19)
+#define SPEEDY_DIRECTION_WRITE		BIT(20)
+
+#define SPEEDY_TRANSFER_DONE		BIT(0)
+#define SPEEDY_TIMEOUT_CMD		BIT(1)
+#define SPEEDY_TIMEOUT_STANDBY		BIT(2)
+#define SPEEDY_TIMEOUT_DATA		BIT(3)
+#define SPEEDY_FIFO_TX_ALMOST_EMPTY	BIT(4)
+#define SPEEDY_FIFO_RX_ALMOST_FULL	BIT(8)
+#define SPEEDY_RX_FIFO_INT_TRAILER	BIT(9)
+#define SPEEDY_RX_MODEBIT_ERR		BIT(16)
+#define SPEEDY_RX_GLITCH_ERR		BIT(17)
+#define SPEEDY_RX_ENDBIT_ERR		BIT(18)
+#define SPEEDY_TX_LINE_BUSY_ERR		BIT(20)
+#define SPEEDY_TX_STOPBIT_ERR		BIT(21)
+
+#define SPEEDY_TIMEOUTS			(SPEEDY_TIMEOUT_CMD | \
+					 SPEEDY_TIMEOUT_STANDBY | \
+					 SPEEDY_TIMEOUT_DATA)
+#define SPEEDY_RX_ERRORS		(SPEEDY_RX_MODEBIT_ERR | \
+					 SPEEDY_RX_GLITCH_ERR | \
+					 SPEEDY_RX_ENDBIT_ERR)
+#define SPEEDY_TX_ERRORS		(SPEEDY_TX_LINE_BUSY_ERR | \
+					 SPEEDY_TX_STOPBIT_ERR)
+#define SPEEDY_ERRORS			(SPEEDY_TIMEOUTS | SPEEDY_RX_ERRORS | \
+					 SPEEDY_TX_ERRORS)
+
+/* IP batcher registers */
+#define IPBATCHER_CON			0x0500
+#define IPBATCHER_STATE			0x0504
+#define IPBATCHER_INT_EN		0x0508
+#define IPBATCHER_FSM_UNEXPEN		0x050c
+#define IPBATCHER_FSM_TXEN		0x0510
+#define IPBATCHER_FSM_RXFIFO		0x0514
+#define IPBATCHER_FSM_CON		0x0518
+#define IPBATCHER_IP_INT_STATUS		0x0520
+#define IPBATCHER_SEMA_REL		0x0200
+#define BATCHER_OPCODE			0x0600
+#define BATCHER_PAYLOAD			0x1000
+#define BATCHER_PAYLOAD_END		0x1060
+
+#define BATCHER_ENABLE			BIT(0)
+#define DEDICATED_BATCHER_APB		BIT(1)
+#define START_BATCHER			BIT(4)
+#define BATCHER_SW_RESET		BIT(31)
+
+#define BATCHER_OPERATION_COMPLETE	BIT(0)
+#define BATCHER_UNEXPECTED_IP_INTR	BIT(1)
+
+#define BATCHER_INTERRUPT_ENABLE	BIT(0)
+#define BATCHER_DISABLE_STOP_CMD	BIT(0)
+
+/* Monitored bit of the controller's FIFO status: RX FIFO empty */
+#define SPEEDY_FIFO_EMPTY		BIT(6)
+
+/* Opcode marking the end of a batcher program */
+#define BATCHER_OPCODE_END		0xff
+#define BATCHER_TIMEOUT_US		500000
+#define SPEEDY_MAX_LEN			16
+
+struct exynos_speedy {
+	struct device *dev;
+	void __iomem *regs;
+	struct clk *clk;
+	struct i2c_adapter adap;
+	/* serializes the batcher programs */
+	struct mutex lock;
+
+	/* batcher program being built */
+	u32 opcodes;
+	unsigned int op_idx;
+	unsigned int op_reg;
+	unsigned int payload_idx;
+};
+
+static void speedy_batch_reset(struct exynos_speedy *speedy)
+{
+	speedy->opcodes = 0xffffffff;
+	speedy->op_idx = 0;
+	speedy->op_reg = 0;
+	speedy->payload_idx = 0;
+}
+
+/*
+ * Append "write @val to the SPEEDY register @reg" to the batcher program.
+ * Each opcode is a register offset; four of them share an opcode word.
+ */
+static int speedy_batch(struct exynos_speedy *speedy, u32 val, u32 reg)
+{
+	unsigned int payload = BATCHER_PAYLOAD + speedy->payload_idx * 4;
+
+	if (payload > BATCHER_PAYLOAD_END)
+		return -E2BIG;
+
+	speedy->opcodes &= ~(0xff << (8 * speedy->op_idx));
+	speedy->opcodes |= (reg & 0xff) << (8 * speedy->op_idx);
+	writel(speedy->opcodes, speedy->regs + BATCHER_OPCODE +
+	       speedy->op_reg * 4);
+	writel(val, speedy->regs + payload);
+
+	speedy->payload_idx++;
+	if (++speedy->op_idx == 4) {
+		speedy->op_idx = 0;
+		speedy->op_reg++;
+		speedy->opcodes = 0xffffffff;
+	}
+
+	return 0;
+}
+
+static void speedy_batcher_setup(struct exynos_speedy *speedy)
+{
+	/* Errors of the controller abort the program */
+	writel(SPEEDY_ERRORS, speedy->regs + IPBATCHER_FSM_UNEXPEN);
+	/* Transfer done and TX FIFO empty end TX steps, the others RX steps */
+	writel(SPEEDY_TRANSFER_DONE | SPEEDY_FIFO_TX_ALMOST_EMPTY,
+	       speedy->regs + IPBATCHER_FSM_TXEN);
+	writel(SPEEDY_FIFO_EMPTY, speedy->regs + IPBATCHER_FSM_RXFIFO);
+	writel(BATCHER_DISABLE_STOP_CMD, speedy->regs + IPBATCHER_FSM_CON);
+}
+
+static void speedy_batcher_sw_reset(struct exynos_speedy *speedy)
+{
+	u32 con = readl(speedy->regs + IPBATCHER_CON);
+
+	writel(con | BATCHER_SW_RESET, speedy->regs + IPBATCHER_CON);
+	writel(con & ~BATCHER_SW_RESET, speedy->regs + IPBATCHER_CON);
+	speedy_batcher_setup(speedy);
+}
+
+static int speedy_batch_run(struct exynos_speedy *speedy)
+{
+	u32 state, status;
+	int ret;
+
+	/* terminate the program */
+	ret = speedy_batch(speedy, 0, BATCHER_OPCODE_END);
+	if (ret)
+		return ret;
+
+	writel(BATCHER_INTERRUPT_ENABLE, speedy->regs + IPBATCHER_INT_EN);
+	writel(readl(speedy->regs + IPBATCHER_CON) | START_BATCHER,
+	       speedy->regs + IPBATCHER_CON);
+
+	ret = readl_poll_timeout(speedy->regs + IPBATCHER_STATE, state,
+				 state & (BATCHER_OPERATION_COMPLETE |
+					  BATCHER_UNEXPECTED_IP_INTR),
+				 10, BATCHER_TIMEOUT_US);
+	status = readl(speedy->regs + IPBATCHER_IP_INT_STATUS);
+
+	writel(0, speedy->regs + IPBATCHER_INT_EN);
+	if (state & BATCHER_OPERATION_COMPLETE)
+		writel(state | BATCHER_OPERATION_COMPLETE,
+		       speedy->regs + IPBATCHER_STATE);
+
+	if (!ret && (status & SPEEDY_ERRORS))
+		ret = -EIO;
+	if (ret)
+		dev_dbg(speedy->dev, "batcher failed: state %#x status %#x\n",
+			state, status);
+
+	return ret;
+}
+
+/* Remote reset of the slaves after an error */
+static void speedy_srp(struct exynos_speedy *speedy)
+{
+	u32 ctrl = SPEEDY_CTRL_RESET_VAL | SPEEDY_ENABLE;
+
+	writel(0, speedy->regs + IPBATCHER_CON);
+	writel(BATCHER_ENABLE | DEDICATED_BATCHER_APB,
+	       speedy->regs + IPBATCHER_CON);
+	speedy_batch_reset(speedy);
+
+	speedy_batch(speedy, SPEEDY_FIFO_RESET | SPEEDY_RX_TRIGGER_LEVEL(1) |
+		     SPEEDY_TX_TRIGGER_LEVEL(1), SPEEDY_FIFO_CTRL);
+	speedy_batch(speedy, 0xffffffff, SPEEDY_INT_STATUS);
+	speedy_batch(speedy, SPEEDY_TIMEOUTS | SPEEDY_TRANSFER_DONE |
+		     SPEEDY_FIFO_TX_ALMOST_EMPTY | SPEEDY_TX_ERRORS,
+		     SPEEDY_INT_ENABLE);
+	speedy_batch(speedy, SPEEDY_ADDRESS(0) | SPEEDY_ACCESS_RANDOM |
+		     SPEEDY_DIRECTION_WRITE, SPEEDY_CMD);
+	speedy_batch(speedy, ctrl | SPEEDY_REMOTE_RESET_REQ, SPEEDY_CTRL);
+	speedy_batch(speedy, 0, SPEEDY_TX_DATA);
+	speedy_batch(speedy, ctrl, SPEEDY_CTRL);
+
+	if (speedy_batch_run(speedy))
+		dev_warn(speedy->dev, "remote reset failed\n");
+	writel(0, speedy->regs + IPBATCHER_CON);
+}
+
+static int speedy_xfer_one(struct exynos_speedy *speedy, u16 addr,
+			   u8 *buf, unsigned int len, bool read)
+{
+	u32 cmd = SPEEDY_ADDRESS(addr);
+	u32 fifo = SPEEDY_FIFO_RESET;
+	u32 int_en = SPEEDY_TIMEOUTS;
+	unsigned int rx_payload, i;
+	int ret;
+
+	if (!len || len > SPEEDY_MAX_LEN)
+		return -EINVAL;
+
+	if (len > 1) {
+		cmd |= SPEEDY_BURST_INCR | SPEEDY_BURST_LENGTH(len - 1);
+		fifo |= SPEEDY_RX_TRIGGER_LEVEL(len) | SPEEDY_TX_TRIGGER_LEVEL(1);
+	} else {
+		cmd |= SPEEDY_ACCESS_RANDOM;
+		fifo |= SPEEDY_RX_TRIGGER_LEVEL(1) | SPEEDY_TX_TRIGGER_LEVEL(1);
+	}
+
+	if (read) {
+		int_en |= SPEEDY_FIFO_RX_ALMOST_FULL | SPEEDY_RX_FIFO_INT_TRAILER |
+			  SPEEDY_RX_ERRORS;
+	} else {
+		cmd |= SPEEDY_DIRECTION_WRITE;
+		int_en |= SPEEDY_TRANSFER_DONE | SPEEDY_FIFO_TX_ALMOST_EMPTY |
+			  SPEEDY_TX_ERRORS;
+	}
+
+	writel(0, speedy->regs + IPBATCHER_CON);
+	writel(BATCHER_ENABLE | DEDICATED_BATCHER_APB,
+	       speedy->regs + IPBATCHER_CON);
+	speedy_batch_reset(speedy);
+
+	speedy_batch(speedy, SPEEDY_CTRL_RESET_VAL | SPEEDY_ENABLE, SPEEDY_CTRL);
+	speedy_batch(speedy, fifo, SPEEDY_FIFO_CTRL);
+	speedy_batch(speedy, 0xffffffff, SPEEDY_INT_STATUS);
+	speedy_batch(speedy, int_en, SPEEDY_INT_ENABLE);
+	speedy_batch(speedy, cmd, SPEEDY_CMD);
+
+	rx_payload = BATCHER_PAYLOAD + speedy->payload_idx * 4;
+	for (i = 0; i < len; i++) {
+		if (read)
+			ret = speedy_batch(speedy, 0, SPEEDY_RX_DATA);
+		else
+			ret = speedy_batch(speedy, buf[i], SPEEDY_TX_DATA);
+		if (ret)
+			return ret;
+	}
+
+	/* no more TX FIFO empty interrupts once the data is queued */
+	if (!read)
+		speedy_batch(speedy, int_en & ~SPEEDY_FIFO_TX_ALMOST_EMPTY,
+			     SPEEDY_INT_ENABLE);
+
+	ret = speedy_batch_run(speedy);
+	if (!ret && read)
+		for (i = 0; i < len; i++)
+			buf[i] = readl(speedy->regs + rx_payload + i * 4);
+
+	writel(0, speedy->regs + IPBATCHER_CON);
+
+	if (ret) {
+		speedy_batcher_sw_reset(speedy);
+		speedy_srp(speedy);
+	}
+
+	return ret;
+}
+
+static int exynos_speedy_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+			      int num)
+{
+	struct exynos_speedy *speedy = i2c_get_adapdata(adap);
+	u16 addr;
+	int ret;
+
+	if (msgs[0].flags & I2C_M_RD || msgs[0].len < 1 || msgs[0].addr > 0xf)
+		return -EOPNOTSUPP;
+
+	addr = msgs[0].addr << 8 | msgs[0].buf[0];
+
+	guard(mutex)(&speedy->lock);
+
+	if (num == 1) {
+		ret = speedy_xfer_one(speedy, addr, msgs[0].buf + 1,
+				      msgs[0].len - 1, false);
+	} else if (num == 2 && msgs[0].len == 1 &&
+		   (msgs[1].flags & I2C_M_RD) && msgs[1].addr == msgs[0].addr) {
+		ret = speedy_xfer_one(speedy, addr, msgs[1].buf, msgs[1].len,
+				      true);
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	return ret ? ret : num;
+}
+
+static u32 exynos_speedy_func(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_I2C | I2C_FUNC_SMBUS_BYTE_DATA |
+	       I2C_FUNC_SMBUS_I2C_BLOCK;
+}
+
+static const struct i2c_algorithm exynos_speedy_algorithm = {
+	.xfer		= exynos_speedy_xfer,
+	.functionality	= exynos_speedy_func,
+};
+
+static const struct i2c_adapter_quirks exynos_speedy_quirks = {
+	.flags		= I2C_AQ_COMB_WRITE_THEN_READ,
+	.max_read_len	= SPEEDY_MAX_LEN,
+	.max_write_len	= SPEEDY_MAX_LEN + 1,
+};
+
+static int exynos_speedy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos_speedy *speedy;
+	int ret;
+
+	speedy = devm_kzalloc(dev, sizeof(*speedy), GFP_KERNEL);
+	if (!speedy)
+		return -ENOMEM;
+
+	speedy->dev = dev;
+	speedy->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(speedy->regs))
+		return PTR_ERR(speedy->regs);
+
+	speedy->clk = devm_clk_get_optional_enabled(dev, NULL);
+	if (IS_ERR(speedy->clk))
+		return dev_err_probe(dev, PTR_ERR(speedy->clk),
+				     "failed to get clock\n");
+
+	ret = devm_mutex_init(dev, &speedy->lock);
+	if (ret)
+		return ret;
+
+	/* The batcher owns the controller, give it a clean state */
+	writel(0xffffffff, speedy->regs + SPEEDY_INT_STATUS);
+	writel(1, speedy->regs + IPBATCHER_SEMA_REL);
+	speedy_batcher_sw_reset(speedy);
+
+	speedy->adap.owner = THIS_MODULE;
+	speedy->adap.algo = &exynos_speedy_algorithm;
+	speedy->adap.quirks = &exynos_speedy_quirks;
+	speedy->adap.retries = 2;
+	speedy->adap.dev.parent = dev;
+	speedy->adap.dev.of_node = dev->of_node;
+	strscpy(speedy->adap.name, "exynos-speedy", sizeof(speedy->adap.name));
+	i2c_set_adapdata(&speedy->adap, speedy);
+
+	return devm_i2c_add_adapter(dev, &speedy->adap);
+}
+
+static const struct of_device_id exynos_speedy_of_match[] = {
+	{ .compatible = "samsung,exynos8895-speedy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos_speedy_of_match);
+
+static struct platform_driver exynos_speedy_driver = {
+	.probe = exynos_speedy_probe,
+	.driver = {
+		.name = "exynos-speedy",
+		.of_match_table = exynos_speedy_of_match,
+	},
+};
+module_platform_driver(exynos_speedy_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos SPEEDY bus driver");
+MODULE_LICENSE("GPL");
