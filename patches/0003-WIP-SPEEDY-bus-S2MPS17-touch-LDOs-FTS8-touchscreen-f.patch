+static int stmfts8_wait_ready(struct stmfts_data *sdata)
+{
+	u8 event[STMFTS_EVENT_SIZE];
+	int i, ret;
+
+	for (i = 0; i < 50; i++) {
+		msleep(10);
+		ret = i2c_smbus_read_i2c_block_data(sdata->client,
+						    STMFTS_READ_ONE_EVENT,
+						    sizeof(event), event);
+		if (ret == sizeof(event) &&
+		    event[0] == STMFTS_EV_CONTROLLER_READY)
+			return 0;
+	}
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * The FTS8 does not drive its interrupt output after a reset until it is
+ * enabled with a register write, so the reset has to be polled.
+ */
+static int stmfts8_configure(struct stmfts_data *sdata)
 {
+	static const u8 int_enable[] = { 0xb6, 0x00, 0x2c, 0x48 };
 	int err;
 
+	err = i2c_smbus_write_byte(sdata->client, STMFTS_SYSTEM_RESET);
+	if (err)
+		return err;
+
+	err = stmfts8_wait_ready(sdata);
+	if (err)
+		return err;
+
+	err = i2c_master_send(sdata->client, int_enable, sizeof(int_enable));
+	if (err < 0)
+		return err;
+
+	err = stmfts_command(sdata, STMFTS_FULL_FORCE_CALIBRATION);
+	if (err)
+		dev_warn(&sdata->client->dev,
+			 "failed to perform force calibration: %d\n", err);
+
+	return 0;
+}
+
+static int stmfts_power_on(struct stmfts_data *sdata)
+{
+	int err, retry;
+
