diff --git a/drivers/regulator/s2mps17-regulator.c b/drivers/regulator/s2mps17-regulator.c
new file mode 100644
index 000000000..ca5dd4b5a
--- /dev/null
+++ b/drivers/regulator/s2mps17-regulator.c
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Regulators of the Samsung S2MPS17 PMIC
+ *
+ * The S2MPS17 is the main PMIC of Exynos8895 boards, connected over the
+ * SPEEDY bus. Only the regulators that have been verified against the
+ * vendor kernel are described, the others are left as the bootloader set
+ * them up.
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define S2MPS17_REG_L34CTRL		0x5f
+#define S2MPS17_REG_L35CTRL		0x60
+
+#define S2MPS17_LDO_VSEL_MASK		0x3f
+#define S2MPS17_LDO_N_VOLTAGES		(S2MPS17_LDO_VSEL_MASK + 1)
+#define S2MPS17_ENABLE_MASK		(0x3 << 6)
+/* "on in normal mode", the other modes follow the PMIC power states */
+#define S2MPS17_ENABLE_NORMAL		(0x3 << 6)
+#define S2MPS17_ENABLE_TIME_LDO		128
+
+enum s2mps17_regulators {
+	S2MPS17_LDO34,
+	S2MPS17_LDO35,
+	S2MPS17_REGULATOR_MAX,
+};
+
+static const struct regulator_ops s2mps17_ldo_ops = {
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.is_enabled		= regulator_is_enabled_regmap,
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel	= regulator_set_voltage_time_sel,
+};
+
+#define S2MPS17_LDO(_num, _min, _step) {			\
+	.name		= "LDO" #_num,				\
+	.of_match	= of_match_ptr("LDO" #_num),		\
+	.regulators_node = of_match_ptr("regulators"),		\
+	.id		= S2MPS17_LDO##_num,			\
+	.ops		= &s2mps17_ldo_ops,			\
+	.type		= REGULATOR_VOLTAGE,			\
+	.owner		= THIS_MODULE,				\
+	.min_uV		= _min,					\
+	.uV_step	= _step,				\
+	.n_voltages	= S2MPS17_LDO_N_VOLTAGES,		\
+	.vsel_reg	= S2MPS17_REG_L##_num##CTRL,		\
+	.vsel_mask	= S2MPS17_LDO_VSEL_MASK,		\
+	.enable_reg	= S2MPS17_REG_L##_num##CTRL,		\
+	.enable_mask	= S2MPS17_ENABLE_MASK,			\
+	.enable_val	= S2MPS17_ENABLE_NORMAL,		\
+	.enable_time	= S2MPS17_ENABLE_TIME_LDO,		\
+}
+
+static const struct regulator_desc s2mps17_regulators[] = {
+	S2MPS17_LDO(34, 700000, 25000),
+	S2MPS17_LDO(35, 1800000, 25000),
+};
+
+static const struct regmap_config s2mps17_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+};
+
+static int s2mps17_regulator_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = { };
+	struct regmap *regmap;
+	int i;
+
+	regmap = devm_regmap_init_i2c(client, &s2mps17_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "failed to init regmap\n");
+
+	config.dev = dev;
+	config.regmap = regmap;
+
+	for (i = 0; i < ARRAY_SIZE(s2mps17_regulators); i++) {
+		struct regulator_dev *rdev;
+
+		rdev = devm_regulator_register(dev, &s2mps17_regulators[i],
+					       &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n",
+					     s2mps17_regulators[i].name);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id s2mps17_regulator_of_match[] = {
+	{ .compatible = "samsung,s2mps17-pmic" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mps17_regulator_of_match);
+
+static struct i2c_driver s2mps17_regulator_driver = {
+	.driver = {
+		.name = "s2mps17-regulator",
+		.of_match_table = s2mps17_regulator_of_match,
+	},
+	.probe = s2mps17_regulator_probe,
+};
+module_i2c_driver(s2mps17_regulator_driver);
+
+MODULE_DESCRIPTION("Samsung S2MPS17 regulator driver");
+MODULE_LICENSE("GPL");
