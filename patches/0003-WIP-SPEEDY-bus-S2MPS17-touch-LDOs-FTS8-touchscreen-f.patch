 				    sdata->supplies);
 	if (err)
@@ -601,7 +650,16 @@ static int stmfts_power_on(struct stmfts_data *sdata)
 	if (sdata->reset_gpio)
 		stmfts_reset(sdata);
 
-	err = stmfts_read_system_info(sdata);
+	/*
+	 * Some controllers (e.g. FTS8 on the Galaxy S8+) take much longer to
+	 * boot and stretch the clock until they are ready.
+	 */
+	for (retry = 0; retry < STMFTS_BOOT_RETRIES; retry++) {
+		err = stmfts_read_system_info(sdata);
+		if (!err)
+			break;
+		msleep(20);
+	}
 	if (err)
 		goto err_disable_regulators;
 
@@ -609,7 +667,10 @@ static int stmfts_power_on(struct stmfts_data *sdata)
 
 	msleep(50);
 
-	err = stmfts_configure(sdata);
+	if (sdata->fts8)
+		err = stmfts8_configure(sdata);
+	else
+		err = stmfts_configure(sdata);
 	if (err)
 		goto err_disable_irq;
 
@@ -617,7 +678,8 @@ static int stmfts_power_on(struct stmfts_data *sdata)
 	 * At this point no one is using the touchscreen
 	 * and I don't really care about the return value
 	 */
-	(void)i2c_smbus_write_byte(sdata->client, STMFTS_SLEEP_IN);
+	(void)i2c_smbus_write_byte(sdata->client, sdata->fts8 ?
+				   STMFTS_MS_MT_SENSE_OFF : STMFTS_SLEEP_IN);
 
 	return 0;
 
@@ -717,6 +779,7 @@ static int stmfts_probe(struct i2c_client *client)
 	input_set_abs_params(sdata->input, ABS_DISTANCE, 0, 255, 0, 0);
 
 	sdata->use_key = device_property_read_bool(dev, "touch-key-connected");
+	sdata->fts8 = device_is_compatible(dev, "st,stmfts8");
 	if (sdata->use_key) {
 		input_set_capability(sdata->input, EV_KEY, KEY_MENU);
 		input_set_capability(sdata->input, EV_KEY, KEY_BACK);
@@ -787,7 +850,9 @@ static int stmfts_runtime_suspend(struct device *dev)
 	struct stmfts_data *sdata = dev_get_drvdata(dev);
 	int ret;
 
-	ret = i2c_smbus_write_byte(sdata->client, STMFTS_SLEEP_IN);
+	/* The FTS8 has no sleep commands, it only stops sensing */
+	ret = i2c_smbus_write_byte(sdata->client, sdata->fts8 ?
+				   STMFTS_MS_MT_SENSE_OFF : STMFTS_SLEEP_IN);
 	if (ret)
 		dev_warn(dev, "failed to suspend device: %d\n", ret);
 
@@ -800,6 +865,9 @@ static int stmfts_runtime_resume(struct device *dev)
 	struct i2c_client *client = sdata->client;
 	int ret;
 
+	if (sdata->fts8)
+		return 0;
+
 	ret = i2c_smbus_write_byte(client, STMFTS_SLEEP_OUT);
 	if (ret)
 		dev_err(dev, "failed to resume device: %d\n", ret);
@@ -831,6 +899,7 @@ static const struct dev_pm_ops stmfts_pm_ops = {
 #ifdef CONFIG_OF
 static const struct of_device_id stmfts_of_match[] = {
 	{ .compatible = "st,stmfts", },
