From 1b8522eabd682d93a5ea3b4a0b4a20029a5e6ab1 Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sun, 15 Nov 2026 10:47:51 +0200
Subject: [PATCH 50/51] WIP: Input: stmfts - sync the MT frame

Call input_mt_sync_frame() before input_sync(), which emits BTN_TOUCH:
without it Android treats the contacts as hovering.

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 drivers/input/touchscreen/stmfts.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/input/touchscreen/stmfts.c b/drivers/input/touchscreen/stmfts.c
index 65415f837..e98b4e106 100644
--- a/drivers/input/touchscreen/stmfts.c
+++ b/drivers/input/touchscreen/stmfts.c
@@ -193,6 +193,8 @@ static void stmfts_report_contact_event(struct stmfts_data *sdata,
 	input_report_abs(sdata->input, ABS_MT_PRESSURE, area);
 	input_report_abs(sdata->input, ABS_MT_ORIENTATION, orientation);
 
+	/* emits BTN_TOUCH; without it Android treats the contacts as hovering */
+	input_mt_sync_frame(sdata->input);
 	input_sync(sdata->input);
 }
 
@@ -204,6 +206,7 @@ static void stmfts_report_contact_release(struct stmfts_data *sdata,
 	input_mt_slot(sdata->input, slot_id);
 	input_mt_report_slot_inactive(sdata->input);
 
+	input_mt_sync_frame(sdata->input);
 	input_sync(sdata->input);
 }
 
