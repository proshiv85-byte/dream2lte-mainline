+/*
+ * Exynos8895 "USBCON" v1.1.1: USB 3.0 DRD PHY with two ports for the two
+ * Type-C orientations. Only the high-speed part on port 0 is used here.
+ * Sequence ported from the vendor kernel's USB PHY CAL.
+ */
+#define EXYNOS8895_DRD_PHYPIPE_CLOCK_SEL	BIT(4)
+#define EXYNOS8895_DRD_PHYPARAM0_TXVREFTUNE	GENMASK(25, 22)
+#define EXYNOS8895_DRD_PHYPARAM0_TXRISETUNE	GENMASK(21, 20)
+#define EXYNOS8895_DRD_PHYPARAM0_TXRESTUNE	GENMASK(19, 18)
+#define EXYNOS8895_DRD_PHYPARAM0_TXPREEMPPULSE	BIT(17)
+#define EXYNOS8895_DRD_PHYPARAM0_TXPREEMPAMP	GENMASK(16, 15)
+#define EXYNOS8895_DRD_PHYPARAM0_TXHSXVTUNE	GENMASK(14, 13)
+#define EXYNOS8895_DRD_PHYPARAM0_TXFSLSTUNE	GENMASK(12, 9)
+#define EXYNOS8895_DRD_PHYPARAM0_SQRXTUNE	GENMASK(8, 6)
+#define EXYNOS8895_DRD_PHYPARAM0_OTGTUNE	GENMASK(5, 3)
+#define EXYNOS8895_DRD_PHYPARAM0_COMPDISTUNE	GENMASK(2, 0)
+#define EXYNOS8895_DRD_PHYRESUME_DIS_LINKGATE	BIT(13)
+#define EXYNOS8895_DRD_PHYRESUME_DIS_ID0	BIT(12)
+#define EXYNOS8895_DRD_PHYRESUME_DIS_VBUSVALID	BIT(11)
+#define EXYNOS8895_DRD_PHYRESUME_DIS_BVALID	BIT(10)
+#define EXYNOS8895_DRD_PHYRESUME_FORCE_QACT	BIT(9)
+#define EXYNOS8895_DRD_LINKSYSTEM_LINK_SW_RST	BIT(28)
+#define EXYNOS8895_DRD_PHYPARAM2		0x50
+#define EXYNOS8895_DRD_PHYPARAM2_TX_VBOOST	GENMASK(6, 4)
+#define EXYNOS8895_DRD_PHYPARAM2_LOS_BIAS	GENMASK(2, 0)
+#define EXYNOS8895_DRD_PHYPCSVAL		0x3c
+#define EXYNOS8895_DRD_PHYPCSVAL_LOS_MASK	GENMASK(9, 0)
+#define EXYNOS8895_DRD_LINKPORT_U3_DISABLE	BIT(8)
+#define EXYNOS8895_DRD_LINKPORT_OVCR_U3_SEL	BIT(3)
+#define EXYNOS8895_DRD_LINKPORT_OVCR_U2_SEL	BIT(2)
+#define EXYNOS8895_DRD_PHYSELECTION		0x6c
+#define EXYNOS8895_DRD_PHYSEL_PIPE_CLK		BIT(3)
+#define EXYNOS8895_DRD_PHYSEL_PIPE		BIT(1)
+
+/* Reference clock: 26 MHz from the clock core */
+#define EXYNOS8895_REFCLKSEL_CLKCORE		0x2
+#define EXYNOS8895_FSEL_26MHZ			0x2
+#define EXYNOS8895_MPLL_MULTIPLIER_26MHZ	0x60
+#define EXYNOS8895_SSC_REFCLKSEL_26MHZ		0x108U
+
+static int exynos8895_usbdrd_map_extra_regs(struct exynos5_usbdrd_phy *phy_drd,
+					    struct platform_device *pdev)
+{
+	phy_drd->reg_phy2 = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(phy_drd->reg_phy2))
+		return PTR_ERR(phy_drd->reg_phy2);
+
+	phy_drd->reg_refclk = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(phy_drd->reg_refclk))
+		return PTR_ERR(phy_drd->reg_refclk);
+
+	return 0;
+}
+
+static void exynos8895_usbdrd_utmi_init(struct exynos5_usbdrd_phy *phy_drd)
+{
+	void __iomem *base, *base2;
+	u32 reg, clkrst;
+
+	/* Newer USBCON versions have a version register at offset 0 */
+	if (!phy_drd->regs_checked) {
+		reg = readl(phy_drd->reg_phy);
+		if (reg) {
+			dev_info(phy_drd->dev, "USBCON version %#x\n", reg);
+			phy_drd->reg_phy += 4;
+			phy_drd->reg_phy2 += 4;
+		}
+		phy_drd->regs_checked = true;
+	}
+	base = phy_drd->reg_phy;
+	base2 = phy_drd->reg_phy2;
+
+	/* Reference clock path of the PHY */
+	reg = readl(phy_drd->reg_refclk + 0xc);
+	writel(reg | BIT(24), phy_drd->reg_refclk + 0xc);
+
+	/* Q-channel workaround: ignore the q-active requests from the PHY */
+	reg = readl(base + EXYNOS5_DRD_PHYRESUME);
+	reg |= EXYNOS8895_DRD_PHYRESUME_DIS_ID0 |
+	       EXYNOS8895_DRD_PHYRESUME_DIS_VBUSVALID |
+	       EXYNOS8895_DRD_PHYRESUME_DIS_BVALID |
+	       EXYNOS8895_DRD_PHYRESUME_DIS_LINKGATE;
+	reg &= ~EXYNOS8895_DRD_PHYRESUME_FORCE_QACT;
+	udelay(500);
+	writel(reg, base + EXYNOS5_DRD_PHYRESUME);
+	udelay(500);
+	reg |= EXYNOS8895_DRD_PHYRESUME_FORCE_QACT;
+	udelay(500);
+	writel(reg, base + EXYNOS5_DRD_PHYRESUME);
+
+	reg = readl(base + EXYNOS5_DRD_LINKSYSTEM);
+	writel(reg | EXYNOS8895_DRD_LINKSYSTEM_LINK_SW_RST,
+	       base + EXYNOS5_DRD_LINKSYSTEM);
+	udelay(10);
+	writel(reg & ~EXYNOS8895_DRD_LINKSYSTEM_LINK_SW_RST,
+	       base + EXYNOS5_DRD_LINKSYSTEM);
+
+	/* PIPE3 from port 0 */
+	reg = readl(base + EXYNOS8895_DRD_PHYSELECTION);
+	reg &= ~(EXYNOS8895_DRD_PHYSEL_PIPE | EXYNOS8895_DRD_PHYSEL_PIPE_CLK);
+	writel(reg, base + EXYNOS8895_DRD_PHYSELECTION);
+
+	clkrst = readl(base + EXYNOS5_DRD_PHYCLKRST);
+	clkrst |= PHYCLKRST_PORTRESET;
+	clkrst &= ~PHYCLKRST_REFCLKSEL;
+	clkrst |= FIELD_PREP(PHYCLKRST_REFCLKSEL, EXYNOS8895_REFCLKSEL_CLKCORE);
+	clkrst &= ~(PHYCLKRST_FSEL_PIPE | PHYCLKRST_FSEL_UTMI);
+	clkrst |= FIELD_PREP(PHYCLKRST_FSEL_UTMI, EXYNOS8895_FSEL_26MHZ);
+
+	/* Common block on in suspend, not controlled by the link */
+	clkrst &= ~(PHYCLKRST_COMMONONN | PHYCLKRST_EN_UTMISUSPEND);
+	clkrst |= PHYCLKRST_RETENABLEN | PHYCLKRST_REF_SSP_EN;
+
+	reg = readl(base + EXYNOS5_DRD_PHYPARAM0);
+	writel(reg & ~PHYPARAM0_REF_USE_PAD, base + EXYNOS5_DRD_PHYPARAM0);
+
+	clkrst &= ~(PHYCLKRST_MPLL_MULTIPLIER | PHYCLKRST_REF_CLKDIV2);
+	clkrst |= FIELD_PREP(PHYCLKRST_MPLL_MULTIPLIER,
+			     EXYNOS8895_MPLL_MULTIPLIER_26MHZ);
+	/* The vendor code shifts the 9-bit value into the 8-bit field */
+	clkrst &= ~PHYCLKRST_SSC_REFCLKSEL;
+	clkrst |= EXYNOS8895_SSC_REFCLKSEL_26MHZ << 23;
+	clkrst |= PHYCLKRST_SSC_EN;
+	clkrst &= ~PHYCLKRST_SSC_RANGE;
+
+	/* UTMI clock from the PHY */
+	reg = readl(base + EXYNOS5_DRD_PHYPIPE);
+	writel(reg | EXYNOS8895_DRD_PHYPIPE_CLOCK_SEL,
+	       base + EXYNOS5_DRD_PHYPIPE);
+
+	writel(clkrst, base + EXYNOS5_DRD_PHYCLKRST);
+	udelay(10);
+	clkrst &= ~PHYCLKRST_PORTRESET;
+	writel(clkrst, base + EXYNOS5_DRD_PHYCLKRST);
+
+	/* Power up port 0, power down the second port */
+	reg = readl(base + EXYNOS5_DRD_PHYTEST);
+	reg &= ~(PHYTEST_POWERDOWN_HSP | PHYTEST_POWERDOWN_SSP);
+	writel(reg, base + EXYNOS5_DRD_PHYTEST);
+	reg = readl(base2 + EXYNOS5_DRD_PHYTEST);
+	reg &= ~(PHYTEST_POWERDOWN_HSP | PHYTEST_POWERDOWN_SSP);
+	writel(reg, base2 + EXYNOS5_DRD_PHYTEST);
+	udelay(1000);
+	reg |= PHYTEST_POWERDOWN_HSP | PHYTEST_POWERDOWN_SSP;
+	writel(reg, base2 + EXYNOS5_DRD_PHYTEST);
+	reg = readl(base2 + EXYNOS5_DRD_PHYUTMI);
+	reg |= PHYUTMI_FORCESLEEP | PHYUTMI_FORCESUSPEND;
+	writel(reg, base2 + EXYNOS5_DRD_PHYUTMI);
+	udelay(500);
+
+	/* VBUS is not routed to the PHY: force VBUS valid */
+	reg = readl(base + EXYNOS5_DRD_LINKSYSTEM);
+	reg |= LINKSYSTEM_FORCE_BVALID | LINKSYSTEM_FORCE_VBUSVALID;
+	writel(reg, base + EXYNOS5_DRD_LINKSYSTEM);
+
+	reg = readl(base + EXYNOS5_DRD_PHYUTMI);
+	reg &= ~(PHYUTMI_FORCESLEEP | PHYUTMI_FORCESUSPEND |
+		 PHYUTMI_DMPULLDOWN | PHYUTMI_DPPULLDOWN | PHYUTMI_DRVVBUS);
+	reg |= PHYUTMI_VBUSVLDEXTSEL | PHYUTMI_VBUSVLDEXT | PHYUTMI_OTGDISABLE;
+	writel(reg, base + EXYNOS5_DRD_PHYUTMI);
+
+	reg = readl(base + EXYNOS5_DRD_LINKPORT);
+	reg |= EXYNOS8895_DRD_LINKPORT_OVCR_U3_SEL |
+	       EXYNOS8895_DRD_LINKPORT_OVCR_U2_SEL;
+	reg &= ~EXYNOS8895_DRD_LINKPORT_U3_DISABLE;
+	writel(reg, base + EXYNOS5_DRD_LINKPORT);
+
+	/* Device mode tuning */
+	reg = readl(base + EXYNOS5_DRD_LINKSYSTEM);
+	reg &= ~LINKSYSTEM_FLADJ;
+	reg |= FIELD_PREP(LINKSYSTEM_FLADJ, 0x20) |
+	       LINKSYSTEM_XHCI_VERSION_CONTROL;
+	writel(reg, base + EXYNOS5_DRD_LINKSYSTEM);
+
+	reg = readl(base + EXYNOS5_DRD_PHYPARAM0);
+	reg &= ~(EXYNOS8895_DRD_PHYPARAM0_TXVREFTUNE |
+		 EXYNOS8895_DRD_PHYPARAM0_TXRISETUNE |
+		 EXYNOS8895_DRD_PHYPARAM0_TXRESTUNE |
+		 EXYNOS8895_DRD_PHYPARAM0_TXPREEMPPULSE |
+		 EXYNOS8895_DRD_PHYPARAM0_TXPREEMPAMP |
+		 EXYNOS8895_DRD_PHYPARAM0_TXHSXVTUNE |
+		 EXYNOS8895_DRD_PHYPARAM0_TXFSLSTUNE |
+		 EXYNOS8895_DRD_PHYPARAM0_SQRXTUNE |
+		 EXYNOS8895_DRD_PHYPARAM0_OTGTUNE |
+		 EXYNOS8895_DRD_PHYPARAM0_COMPDISTUNE);
+	reg |= FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_TXVREFTUNE, 0xc) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_TXRISETUNE, 0x1) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_TXRESTUNE, 0x3) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_TXPREEMPAMP, 0x3) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_TXHSXVTUNE, 0x3) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_TXFSLSTUNE, 0x3) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_SQRXTUNE, 0x4) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_OTGTUNE, 0x3) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM0_COMPDISTUNE, 0x2);
+	writel(reg, base + EXYNOS5_DRD_PHYPARAM0);
+
+	reg = readl(base + EXYNOS8895_DRD_PHYPARAM2);
+	reg &= ~(EXYNOS8895_DRD_PHYPARAM2_TX_VBOOST |
+		 EXYNOS8895_DRD_PHYPARAM2_LOS_BIAS);
+	reg |= FIELD_PREP(EXYNOS8895_DRD_PHYPARAM2_TX_VBOOST, 0x6) |
+	       FIELD_PREP(EXYNOS8895_DRD_PHYPARAM2_LOS_BIAS, 0x5);
+	writel(reg, base + EXYNOS8895_DRD_PHYPARAM2);
+
+	reg = readl(base + EXYNOS8895_DRD_PHYPCSVAL);
+	reg &= ~EXYNOS8895_DRD_PHYPCSVAL_LOS_MASK;
+	reg |= FIELD_PREP(EXYNOS8895_DRD_PHYPCSVAL_LOS_MASK, 0x104);
+	writel(reg, base + EXYNOS8895_DRD_PHYPCSVAL);
+}
+
+static int exynos8895_usbdrd_phy_init(struct phy *phy)
+{
+	struct phy_usb_instance *inst = phy_get_drvdata(phy);
+	struct exynos5_usbdrd_phy *phy_drd = to_usbdrd_phy(inst);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(phy_drd->drv_data->n_clks, phy_drd->clks);
+	if (ret)
+		return ret;
+
+	scoped_guard(mutex, &phy_drd->phy_mutex)
+		inst->phy_cfg->phy_init(phy_drd);
+
+	/* The PHY registers lose their state without the clock */
+	return 0;
+}
+
+static int exynos8895_usbdrd_phy_exit(struct phy *phy)
+{
+	struct phy_usb_instance *inst = phy_get_drvdata(phy);
+	struct exynos5_usbdrd_phy *phy_drd = to_usbdrd_phy(inst);
+	void __iomem *base = phy_drd->reg_phy;
+	u32 reg;
+
+	scoped_guard(mutex, &phy_drd->phy_mutex) {
+		reg = readl(base + EXYNOS5_DRD_PHYUTMI);
+		reg &= ~(PHYUTMI_IDPULLUP | PHYUTMI_DRVVBUS |
+			 PHYUTMI_VBUSVLDEXTSEL | PHYUTMI_VBUSVLDEXT);
+		reg |= PHYUTMI_FORCESUSPEND | PHYUTMI_FORCESLEEP;
+		writel(reg, base + EXYNOS5_DRD_PHYUTMI);
+
+		reg = readl(base + EXYNOS5_DRD_PHYTEST);
+		reg |= PHYTEST_POWERDOWN_HSP | PHYTEST_POWERDOWN_SSP;
+		writel(reg, base + EXYNOS5_DRD_PHYTEST);
+
+		reg = readl(base + EXYNOS5_DRD_LINKSYSTEM);
+		reg &= ~(LINKSYSTEM_FORCE_BVALID | LINKSYSTEM_FORCE_VBUSVALID);
+		writel(reg, base + EXYNOS5_DRD_LINKSYSTEM);
+	}
+
+	clk_bulk_disable_unprepare(phy_drd->drv_data->n_clks, phy_drd->clks);
+
+	return 0;
+}
+
+static const struct phy_ops exynos8895_usbdrd_phy_ops = {
+	.init		= exynos8895_usbdrd_phy_init,
+	.exit		= exynos8895_usbdrd_phy_exit,
+	.power_on	= exynos5_usbdrd_phy_power_on,
+	.power_off	= exynos5_usbdrd_phy_power_off,
+	.owner		= THIS_MODULE,
+};
