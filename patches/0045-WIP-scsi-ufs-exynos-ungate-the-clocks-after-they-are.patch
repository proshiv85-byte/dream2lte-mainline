From 34694c274f925d9df1185050e4c7a0f644522414 Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sun, 15 Nov 2026 10:47:50 +0200
Subject: [PATCH 45/51] WIP: scsi: ufs: exynos: ungate the clocks after they
 are enabled

The core calls setup_clocks() with PRE_CHANGE before it enables the
clocks. Ungating the HCI clocks writes HCI registers, which aborts when
the clocks are off, as on resume from system suspend on Exynos8895: do
it in POST_CHANGE.

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 drivers/ufs/host/ufs-exynos.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/ufs/host/ufs-exynos.c b/drivers/ufs/host/ufs-exynos.c
index 4d4730686..bb2bf67a6 100644
--- a/drivers/ufs/host/ufs-exynos.c
+++ b/drivers/ufs/host/ufs-exynos.c
@@ -1122,7 +1122,8 @@ static int exynos_ufs_setup_clocks(struct ufs_hba *hba, bool on,
 	if (!ufs)
 		return 0;
 
-	if (on && status == PRE_CHANGE) {
+	if (on && status == POST_CHANGE) {
+		/* only once the clocks run: the HCI registers need them */
 		if (ufs->opts & EXYNOS_UFS_OPT_BROKEN_AUTO_CLK_CTRL)
 			exynos_ufs_disable_auto_ctrl_hcc(ufs);
 		exynos_ufs_ungate_clks(ufs);
@@ -1146,7 +1147,7 @@ static int exynos_ufs_pre_link(struct ufs_hba *hba)
 	exynos_ufs_config_intr(ufs, DFES_DEF_L4_ERRS, UNIPRO_L4);
 	exynos_ufs_set_unipro_pclk_div(ufs);
 
-	exynos_ufs_setup_clocks(hba, true, PRE_CHANGE);
+	exynos_ufs_setup_clocks(hba, true, POST_CHANGE);
 
 	/* unipro */
 	exynos_ufs_config_unipro(ufs);
