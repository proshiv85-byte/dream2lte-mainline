+	plugins = acpm->sram_base + readl(&shmem->plugins);
+	num = readl(&shmem->num_plugins);
+
+	for (i = 0; i < num; i++) {
+		id = readl(&plugins[i].id);
+		attached = readl(&plugins[i].is_attached) & 0xff;
+		stay = readl(&plugins[i].stay_attached) & 0xff;
