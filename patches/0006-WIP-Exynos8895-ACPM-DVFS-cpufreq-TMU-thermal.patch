+		if (stay) {
+			ret = acpm_plugin_load(acpm, &plugins[i]);
+			if (ret)
+				return dev_err_probe(acpm->dev, ret,
+						     "plugin %u load failed\n", id);
+		}
+
+		ret = acpm_plugin_cmd(acpm, chan_id, id, stay);
+		if (ret)
+			return dev_err_probe(acpm->dev, ret,
+					     "plugin %u %s failed\n", id,
+					     stay ? "attach" : "detach");
+	}
+
+	return 0;
+}
