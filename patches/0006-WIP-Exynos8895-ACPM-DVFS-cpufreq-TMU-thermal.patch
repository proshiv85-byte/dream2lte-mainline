+/**
+ * acpm_plugin_load() - copy a plugin firmware file into SRAM.
+ * @acpm:	pointer to driver data.
+ * @plugin:	__iomem pointer to the plugin described in shared memory.
+ *
+ * Return: 0 on success, -errno otherwise.
+ */
+static int acpm_plugin_load(struct acpm_info *acpm,
+			    struct acpm_plugin_shmem __iomem *plugin)
+{
+	u32 base = readl(&plugin->base) & ~1;
+	u32 size = readl(&plugin->size);
+	u32 name_off = readl(&plugin->fw_name);
+	const struct firmware *fw;
+	char name[64];
+	int ret;
+
+	if (!name_off || name_off + sizeof(name) > acpm->sram_size ||
+	    !base || base + size > acpm->sram_size)
+		return -EINVAL;
+
+	memcpy_fromio(name, acpm->sram_base + name_off, sizeof(name) - 1);
+	name[sizeof(name) - 1] = '\0';
+
+	ret = request_firmware(&fw, name, acpm->dev);
+	if (ret)
+		return ret;
+
+	if (fw->size > size || fw->size % 4) {
+		dev_err(acpm->dev, "%s: bad size %zu (slot %u)\n", name,
+			fw->size, size);
+		ret = -EINVAL;
+	} else {
+		__iowrite32_copy(acpm->sram_base + base, fw->data,
+				 fw->size / 4);
+		dev_info(acpm->dev, "loaded plugin %s\n", name);
+	}
+
+	release_firmware(fw);
+
+	return ret;
+}
