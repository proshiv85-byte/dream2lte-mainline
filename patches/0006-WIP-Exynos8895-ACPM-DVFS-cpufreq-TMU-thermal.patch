diff --git a/drivers/thermal/samsung/exynos8895_tmu.c b/drivers/thermal/samsung/exynos8895_tmu.c
new file mode 100644
index 000000000..da483f7a2
--- /dev/null
+++ b/drivers/thermal/samsung/exynos8895_tmu.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos8895 thermal management unit (TMU) sensor driver
+ *
+ * Each TMU block has up to eight remote temperature probes, every one of them
+ * with its own fused calibration data. The bootloader leaves the blocks
+ * enabled and the hardware thermal trip armed, so this driver only reads the
+ * probes and leaves trips to the thermal core, which polls them.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#include "../thermal_hwmon.h"
+
+#define EXYNOS8895_TMU_REG_TRIMINFO(n)	(0x0 + (n) * 4)
+#define EXYNOS8895_TMU_REG_CONTROL	0x20
+#define EXYNOS8895_TMU_REG_CONTROL1	0x24
+#define EXYNOS8895_TMU_REG_CURRENT_TEMP	0x40
+
+#define EXYNOS8895_TMU_CALIB_SEL	BIT(23)
+#define EXYNOS8895_TMU_TRIM_25		GENMASK(8, 0)
+#define EXYNOS8895_TMU_TRIM_85		GENMASK(17, 9)
+#define EXYNOS8895_TMU_CORE_EN		BIT(0)
+#define EXYNOS8895_TMU_NUM_PROBE	GENMASK(18, 16)
+#define EXYNOS8895_TMU_TEMP_MASK	GENMASK(8, 0)
+#define EXYNOS8895_TMU_TEMP_SHIFT	9
+
+#define EXYNOS8895_TMU_MAX_PROBES	8
+#define EXYNOS8895_TMU_FIRST_POINT	25000
+#define EXYNOS8895_TMU_SECOND_POINT	85000
+
+struct exynos8895_tmu;
+
+struct exynos8895_tmu_probe {
+	struct exynos8895_tmu *tmu;
+	unsigned int id;
+	int error1;
+	int error2;
+};
+
+struct exynos8895_tmu {
+	void __iomem *base;
+	bool two_point;
+	struct exynos8895_tmu_probe probes[EXYNOS8895_TMU_MAX_PROBES];
+};
+
+static u32 exynos8895_tmu_read_code(struct exynos8895_tmu *tmu, unsigned int id)
+{
+	unsigned int reg, shift;
+
+	/* probes 0-1 share the first register, then three per register */
+	if (id < 2) {
+		reg = 0;
+		shift = id;
+	} else {
+		reg = (id - 2) / 3 + 1;
+		shift = (id - 2) % 3;
+	}
+
+	return (readl(tmu->base + EXYNOS8895_TMU_REG_CURRENT_TEMP + reg * 4) >>
+		(shift * EXYNOS8895_TMU_TEMP_SHIFT)) & EXYNOS8895_TMU_TEMP_MASK;
+}
+
+static int exynos8895_tmu_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct exynos8895_tmu_probe *probe = thermal_zone_device_priv(tz);
+	struct exynos8895_tmu *tmu = probe->tmu;
+	int code = exynos8895_tmu_read_code(tmu, probe->id);
+
+	if (!code)
+		return -EAGAIN;
+
+	if (tmu->two_point)
+		*temp = (code - probe->error1) *
+			(EXYNOS8895_TMU_SECOND_POINT - EXYNOS8895_TMU_FIRST_POINT) /
+			(probe->error2 - probe->error1) +
+			EXYNOS8895_TMU_FIRST_POINT;
+	else
+		*temp = (code - probe->error1) * 1000 +
+			EXYNOS8895_TMU_FIRST_POINT;
+
+	return 0;
+}
+
+static const struct thermal_zone_device_ops exynos8895_tmu_ops = {
+	.get_temp = exynos8895_tmu_get_temp,
+};
+
+static int exynos8895_tmu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct thermal_zone_device *tzd;
+	struct exynos8895_tmu *tmu;
+	unsigned int i, num_probes;
+	struct clk *clk;
+	u32 trim;
+
+	tmu = devm_kzalloc(dev, sizeof(*tmu), GFP_KERNEL);
+	if (!tmu)
+		return -ENOMEM;
+
+	tmu->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(tmu->base))
+		return PTR_ERR(tmu->base);
+
+	clk = devm_clk_get_optional_enabled(dev, "tmu_apbif");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "failed to get clock\n");
+
+	if (!(readl(tmu->base + EXYNOS8895_TMU_REG_CONTROL) &
+	      EXYNOS8895_TMU_CORE_EN))
+		return dev_err_probe(dev, -ENODEV,
+				     "TMU not enabled by the bootloader\n");
+
+	num_probes = FIELD_GET(EXYNOS8895_TMU_NUM_PROBE,
+			       readl(tmu->base + EXYNOS8895_TMU_REG_CONTROL1)) + 1;
+	tmu->two_point = readl(tmu->base + EXYNOS8895_TMU_REG_TRIMINFO(0)) &
+			 EXYNOS8895_TMU_CALIB_SEL;
+
+	for (i = 0; i < num_probes; i++) {
+		struct exynos8895_tmu_probe *probe = &tmu->probes[i];
+
+		trim = readl(tmu->base + EXYNOS8895_TMU_REG_TRIMINFO(i));
+		probe->tmu = tmu;
+		probe->id = i;
+		probe->error1 = FIELD_GET(EXYNOS8895_TMU_TRIM_25, trim);
+		probe->error2 = FIELD_GET(EXYNOS8895_TMU_TRIM_85, trim);
+		if (!probe->error1 ||
+		    (tmu->two_point && probe->error2 <= probe->error1)) {
+			dev_warn(dev, "probe %u: bad trim data %#x\n", i, trim);
+			continue;
+		}
+
+		tzd = devm_thermal_of_zone_register(dev, i, probe,
+						    &exynos8895_tmu_ops);
+		if (IS_ERR(tzd)) {
+			if (PTR_ERR(tzd) == -ENODEV)
+				continue;
+			return dev_err_probe(dev, PTR_ERR(tzd),
+					     "failed to register probe %u\n", i);
+		}
+
+		devm_thermal_add_hwmon_sysfs(dev, tzd);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id exynos8895_tmu_match[] = {
+	{ .compatible = "samsung,exynos8895-tmu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos8895_tmu_match);
+
+static struct platform_driver exynos8895_tmu_driver = {
+	.driver = {
+		.name = "exynos8895-tmu",
+		.of_match_table = exynos8895_tmu_match,
+	},
+	.probe = exynos8895_tmu_probe,
+};
+module_platform_driver(exynos8895_tmu_driver);
+
+MODULE_DESCRIPTION("Exynos8895 TMU sensor driver");
+MODULE_LICENSE("GPL");
