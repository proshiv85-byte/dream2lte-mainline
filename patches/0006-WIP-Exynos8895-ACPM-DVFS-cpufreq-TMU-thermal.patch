+	u32 cmd[4] = {};
+
+	cmd[0] = FIELD_PREP(ACPM_PROTOCOL_PLUGIN_ID, id) |
+		 (attach ? ACPM_PROTOCOL_PLUGIN_ATTACH :
+			   ACPM_PROTOCOL_PLUGIN_DETACH);
