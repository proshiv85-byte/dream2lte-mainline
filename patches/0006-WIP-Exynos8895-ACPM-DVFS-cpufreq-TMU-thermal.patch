diff --git a/drivers/clk/samsung/clk-acpm.c b/drivers/clk/samsung/clk-acpm.c
index 7680bc8c5..b66d677ed 100644
--- a/drivers/clk/samsung/clk-acpm.c
+++ b/drivers/clk/samsung/clk-acpm.c
@@ -21,16 +21,26 @@ struct acpm_clk {
 	struct clk_hw hw;
 	unsigned int mbox_chan_id;
 	struct acpm_handle *handle;
+	bool cache_rate;
+	unsigned long rate;
 };
 
 struct acpm_clk_variant {
 	const char *name;
 };
 
+/**
+ * struct acpm_clk_driver_data - per-SoC ACPM clock description.
+ * @clks:		clocks, indexed by their ACPM ID.
+ * @nr_clks:		number of clocks.
+ * @mbox_chan_id:	ACPM channel used for DVFS requests.
+ * @cache_rate:		the firmware can't report rates, return the last one set.
+ */
 struct acpm_clk_driver_data {
 	const struct acpm_clk_variant *clks;
 	unsigned int nr_clks;
 	unsigned int mbox_chan_id;
+	bool cache_rate;
 };
 
 #define to_acpm_clk(clk) container_of(clk, struct acpm_clk, hw)
@@ -63,11 +73,34 @@ static const struct acpm_clk_driver_data acpm_clk_gs101 = {
 	.mbox_chan_id = 0,
 };
 
+static const struct acpm_clk_variant exynos8895_acpm_clks[] = {
+	ACPM_CLK("mif"),
+	ACPM_CLK("int"),
+	ACPM_CLK("cpucl0"),
+	ACPM_CLK("cpucl1"),
+	ACPM_CLK("g3d"),
+	ACPM_CLK("intcam"),
+	ACPM_CLK("cam"),
+	ACPM_CLK("disp"),
+	ACPM_CLK("g3dm"),
+	ACPM_CLK("cp"),
+};
+
+static const struct acpm_clk_driver_data acpm_clk_exynos8895 = {
+	.clks = exynos8895_acpm_clks,
+	.nr_clks = ARRAY_SIZE(exynos8895_acpm_clks),
+	.mbox_chan_id = 0,
+	.cache_rate = true,
+};
+
 static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate)
 {
 	struct acpm_clk *clk = to_acpm_clk(hw);
 
+	if (clk->cache_rate)
+		return clk->rate;
+
 	return clk->handle->ops->dvfs.get_rate(clk->handle, clk->mbox_chan_id,
 					       clk->id);
 }
@@ -76,9 +109,14 @@ static int acpm_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 			     unsigned long parent_rate)
 {
 	struct acpm_clk *clk = to_acpm_clk(hw);
+	int ret;
+
+	ret = clk->handle->ops->dvfs.set_rate(clk->handle, clk->mbox_chan_id,
+					      clk->id, rate);
+	if (!ret)
+		clk->rate = rate;
 
-	return clk->handle->ops->dvfs.set_rate(clk->handle, clk->mbox_chan_id,
-					       clk->id, rate);
