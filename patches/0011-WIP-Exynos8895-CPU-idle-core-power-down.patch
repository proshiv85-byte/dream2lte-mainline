diff --git a/drivers/soc/samsung/exynos8895-cpupm.c b/drivers/soc/samsung/exynos8895-cpupm.c
new file mode 100644
index 000000000..29f381d9a
--- /dev/null
+++ b/drivers/soc/samsung/exynos8895-cpupm.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos8895 CPU power-down for cpuidle
+ *
+ * The EL3 firmware's PSCI CPU_SUSPEND prepares the core for power-down, but
+ * the core is only switched off when its local power configuration in the
+ * PMU says so. As on the vendor kernel, clear it right before the PSCI call
+ * and set it again on the way out.
+ *
+ * Only cores are powered down: the PSCI state does not flush the L2, so the
+ * cluster power-down the bootloader leaves armed on one cluster would lose
+ * its dirty lines once all of its cores are off.
+ */
+
+#include <linux/cpu_pm.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <asm/cputype.h>
+
+/* local power configuration of a core, index ((aff1 << 2) | aff0) */
+#define PMU_CPU_CONFIGURATION(n)	(0x2000 + (n) * 0x80)
+#define PMU_CPU_LOCAL_PWR_CFG		0xf
+/* cluster power-down (L2 included) once all its cores are off */
+#define PMU_CLUSTER_CPUSEQ_OPTION(c)	(0x2488 + (c) * 0x20)
+#define PMU_CLUSTER_CPUSEQ_PWRDN	BIT(0)
+#define NR_CLUSTERS			2
+/* droop detector of the Mongoose cores, follows the core power state */
+#define DD_DA_INPUT(n)			((n) * 0x400)
+#define DD_DA_INPUT_EN			BIT(0)
+#define DD_BASE				0x16840000
+#define DD_SIZE				0x1000
+#define NR_DD_CORES			4
+
+static bool enable = true;
+module_param(enable, bool, 0644);
+MODULE_PARM_DESC(enable, "allow cores to power down when idle");
+
+static void __iomem *pmu_base;
+static void __iomem *dd_base;
+
+static unsigned int exynos8895_phycpu(void)
+{
+	u64 mpidr = read_cpuid_mpidr();
+
+	return (MPIDR_AFFINITY_LEVEL(mpidr, 1) << 2) |
+	       MPIDR_AFFINITY_LEVEL(mpidr, 0);
+}
+
+static void exynos8895_cpu_power(unsigned int n, bool on)
+{
+	if (n < NR_DD_CORES && !on)
+		writel(0, dd_base + DD_DA_INPUT(n));
+
+	writel(on ? PMU_CPU_LOCAL_PWR_CFG : 0,
+	       pmu_base + PMU_CPU_CONFIGURATION(n));
+
+	if (n < NR_DD_CORES && on)
+		writel(DD_DA_INPUT_EN, dd_base + DD_DA_INPUT(n));
+}
+
+static int exynos8895_cpu_pm_notify(struct notifier_block *nb,
+				    unsigned long action, void *data)
+{
+	switch (action) {
+	case CPU_PM_ENTER:
+		/* the idle state is skipped while power-down is not allowed */
+		if (!READ_ONCE(enable))
+			return NOTIFY_BAD;
+		exynos8895_cpu_power(exynos8895_phycpu(), false);
+		break;
+	case CPU_PM_ENTER_FAILED:
+	case CPU_PM_EXIT:
+		exynos8895_cpu_power(exynos8895_phycpu(), true);
+		break;
+	}
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block exynos8895_cpu_pm_nb = {
+	.notifier_call = exynos8895_cpu_pm_notify,
+	/* last in, so the core config is the final step before PSCI */
+	.priority = INT_MIN,
+};
+
+static int __init exynos8895_cpupm_init(void)
+{
+	struct device_node *np;
+	unsigned int c;
+
+	if (!of_machine_is_compatible("samsung,exynos8895"))
+		return 0;
+
+	np = of_find_compatible_node(NULL, NULL, "samsung,exynos8895-pmu");
+	if (!np)
+		return -ENODEV;
+
+	pmu_base = of_iomap(np, 0);
+	of_node_put(np);
+	if (!pmu_base)
+		return -ENOMEM;
+
+	dd_base = ioremap(DD_BASE, DD_SIZE);
+	if (!dd_base) {
+		iounmap(pmu_base);
+		return -ENOMEM;
+	}
+
+	for (c = 0; c < NR_CLUSTERS; c++) {
+		u32 val = readl(pmu_base + PMU_CLUSTER_CPUSEQ_OPTION(c));
+
+		writel(val & ~PMU_CLUSTER_CPUSEQ_PWRDN,
+		       pmu_base + PMU_CLUSTER_CPUSEQ_OPTION(c));
+	}
+
+	return cpu_pm_register_notifier(&exynos8895_cpu_pm_nb);
+}
+arch_initcall(exynos8895_cpupm_init);
+
+MODULE_DESCRIPTION("Exynos8895 CPU power-down for cpuidle");
+MODULE_LICENSE("GPL");
