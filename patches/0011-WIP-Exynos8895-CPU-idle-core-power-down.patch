 			capacity-dmips-mhz = <1024>;
+			cpu-idle-states = <&big_cpu_sleep>;
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpucl0_opp_table>;
 		};
@@ -132,6 +160,7 @@ cpu5: cpu@1 {
 			enable-method = "psci";
 			clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL0>;
