 		};
@@ -99,6 +124,7 @@ cpu2: cpu@102 {
 			enable-method = "psci";
 			clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
 			capacity-dmips-mhz = <451>;
+			cpu-idle-states = <&little_cpu_sleep>;
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpucl1_opp_table>;
 		};
@@ -110,6 +136,7 @@ cpu3: cpu@103 {
 			enable-method = "psci";
 			clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
 			capacity-dmips-mhz = <451>;
+			cpu-idle-states = <&little_cpu_sleep>;
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpucl1_opp_table>;
