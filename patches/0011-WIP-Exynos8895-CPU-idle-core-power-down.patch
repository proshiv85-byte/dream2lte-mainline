 		#address-cells = <1>;
 		#size-cells = <0>;
 
+		idle-states {
+			entry-method = "psci";
+
+			/* core power down, values from the vendor kernel */
+			little_cpu_sleep: cpu-sleep-0 {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <35>;
+				exit-latency-us = <90>;
+				min-residency-us = <750>;
+			};
+
+			big_cpu_sleep: cpu-sleep-1 {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <30>;
+				exit-latency-us = <75>;
+				min-residency-us = <2000>;
+			};
+		};
+
 		cpu-map {
 			cluster0 {
 				core0 {
@@ -77,6 +100,7 @@ cpu0: cpu@100 {
 			enable-method = "psci";
 			clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
 			capacity-dmips-mhz = <451>;
+			cpu-idle-states = <&little_cpu_sleep>;
 			#cooling-cells = <2>;
 			operating-points-v2 = <&cpucl1_opp_table>;
 		};
@@ -88,6 +112,7 @@ cpu1: cpu@101 {
 			enable-method = "psci";
 			clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
 			capacity-dmips-mhz = <451>;
+			cpu-idle-states = <&little_cpu_sleep>;
 			#cooling-cells = <2>;
