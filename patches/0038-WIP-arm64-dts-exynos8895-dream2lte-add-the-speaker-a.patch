From 5879d4f744318c8ba7b0a0ee1d885a4f32f349ff Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sat, 24 Oct 2026 11:20:29 +0300
Subject: [PATCH 38/42] WIP: arm64: dts: exynos8895-dream2lte: add the speaker
 amplifier

The MAX98506 is at 0x31 on HSI2C11 (USI3), its I2S is UAIF4 on
gph3-0..3 (the vendor DT names the wrong pins).

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 .../boot/dts/exynos/exynos8895-dream2lte.dts    | 17 +++++++++++++++++
 .../boot/dts/exynos/exynos8895-pinctrl.dtsi     | 12 ++++++++++++
 arch/arm64/boot/dts/exynos/exynos8895.dtsi      |  2 +-
 3 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
index 732800f41..db5bce81d 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
@@ -125,6 +125,7 @@ sound {
 		compatible = "samsung,dream2lte-audio";
 		samsung,cpu = <&abox>;
 		samsung,codec = <&codec>;
+		samsung,speaker-amp = <&speaker_amp>;
 	};
 
 	sd_vmmc: regulator-sd-vmmc {
@@ -565,6 +566,22 @@ usbc_hs: endpoint {
 	};
 };
 
+&usi3 {
+	samsung,mode = <USI_MODE_I2C>;
+
+	status = "okay";
+};
+
+&hsi2c_11 {
+	status = "okay";
+
+	speaker_amp: audio-amplifier@31 {
+		compatible = "maxim,max98506";
+		reg = <0x31>;
+		#sound-dai-cells = <0>;
+	};
+};
+
 &usi9 {
 	samsung,mode = <USI_MODE_I2C0_1>;
 
diff --git a/arch/arm64/boot/dts/exynos/exynos8895-pinctrl.dtsi b/arch/arm64/boot/dts/exynos/exynos8895-pinctrl.dtsi
index 468219ebe..65f25cf39 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos8895-pinctrl.dtsi
@@ -38,6 +38,18 @@ aud_codec_bus: aud-codec-bus-pins {
 		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
 		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
 	};
+
+	/*
+	 * UAIF4 comes out on gph3-0..3 (BCLK, LRCLK, SDO, SDI). The vendor
+	 * DT calls this group "aud-cdma-bus" and lists gph0-5..7 as the
+	 * speaker bus, but it puts every ABOX pad group into function 2, so
+	 * the speaker only worked there by accident.
+	 */
+	aud_spk_bus: aud-spk-bus-pins {
+		samsung,pins = "gph3-0", "gph3-1", "gph3-2", "gph3-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+	};
 };
 
 &pinctrl_alive {
diff --git a/arch/arm64/boot/dts/exynos/exynos8895.dtsi b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
index 66fdbec2a..3c650e9a3 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
@@ -1919,7 +1919,7 @@ abox: audio-controller@13e50000 {
 			iommus = <&sysmmu_abox>;
 			power-domains = <&pd_abox>;
 			samsung,pmu-syscon = <&pmu_system_controller>;
-			pinctrl-0 = <&aud_codec_bus>;
+			pinctrl-0 = <&aud_codec_bus &aud_spk_bus>;
 			pinctrl-names = "default";
 			#sound-dai-cells = <0>;
 			status = "disabled";
