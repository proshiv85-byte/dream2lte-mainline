From 0e522ace5b3528bbc7d482db089670323708c5a8 Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Fri, 23 Oct 2026 18:15:53 +0300
Subject: [PATCH 19/19] WIP: arm64: dts: exynos8895: add the MFC video codec

Power domain and clocks are left on by the bootloader (powering the
domain off would reset its clock muxes), the SysMMUs stay in bypass.

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 arch/arm64/boot/dts/exynos/exynos8895.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos8895.dtsi b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
index 435a069e8..9c1083dd9 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
@@ -1884,6 +1884,17 @@ gpu: gpu@13900000 {
 			#cooling-cells = <2>;
 		};
 
+		mfc: codec@13ce0000 {
+			compatible = "samsung,exynos8895-mfc";
+			reg = <0x13ce0000 0x10000>;
+			interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>;
+			/*
+			 * Power domain and clocks are left on by the bootloader
+			 * (powering the domain off would reset its clock muxes),
+			 * the SysMMUs in front of it stay in bypass.
+			 */
+		};
+
 		pinctrl_abox: pinctrl@13e60000 {
 			compatible = "samsung,exynos8895-pinctrl";
 			reg = <0x13e60000 0x1000>;
