From c62e11d576df04438c1728ea3f94bcff5d53232c Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sun, 15 Nov 2026 10:47:51 +0200
Subject: [PATCH 48/51] WIP: rtc: s2mps17: add the alarm

Alarm 0 (one enable bit per time field, committed with AUDR) raises
RTCA0 in the PMIC's INT2 register, which signals on the PMIC interrupt
line. Unmask only RTCA0, read (and so clear) the interrupt registers in
the threaded handler. With wakeup-source the alarm wakes the system from
suspend (rtcwake).

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 drivers/rtc/rtc-s2mps17.c | 233 ++++++++++++++++++++++++++++++++++----
 1 file changed, 213 insertions(+), 20 deletions(-)

diff --git a/drivers/rtc/rtc-s2mps17.c b/drivers/rtc/rtc-s2mps17.c
index 466ed241f..b34b8c9e4 100644
--- a/drivers/rtc/rtc-s2mps17.c
+++ b/drivers/rtc/rtc-s2mps17.c
@@ -3,14 +3,19 @@
  * RTC of the Samsung S2MPS17 PMIC
  *
  * The RTC block of the PMIC is reached through its own SPEEDY address.
- * The counters run in binary 24h mode as set up by the bootloader; alarms
- * are not supported yet.
+ * The counters run in binary 24h mode as set up by the bootloader.
+ *
+ * Alarm 0 raises RTCA0 in the PMIC's INT2 register, which is on the PMIC's
+ * own address (1) and is cleared by reading it; the PMIC signals its
+ * interrupts on one line to the SoC. Only RTCA0 is unmasked here, so the
+ * line belongs to this driver.
  */
 
 #include <linux/bitops.h>
 #include <linux/delay.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
+#include <linux/interrupt.h>
 #include <linux/of.h>
 #include <linux/regmap.h>
 #include <linux/rtc.h>
@@ -18,6 +23,16 @@
 #define S2MPS17_RTC_REG_CTRL		0x00
 #define S2MPS17_RTC_REG_UPDATE		0x02
 #define S2MPS17_RTC_REG_SEC		0x05
+#define S2MPS17_RTC_REG_A0SEC		0x0c
+#define S2MPS17_RTC_ALARM_EN		BIT(7)
+
+/* on the PMIC address */
+#define S2MPS17_PMIC_ADDR		0x1
+#define S2MPS17_PMIC_REG_INT1		0x00
+#define S2MPS17_PMIC_REG_INT2		0x01
+#define S2MPS17_PMIC_INT2_RTCA0		BIT(2)
+#define S2MPS17_PMIC_REG_INT1M		0x06
+#define S2MPS17_PMIC_NR_INT		6
 
 #define S2MPS17_RTC_CTRL_BCD_EN		BIT(0)
 #define S2MPS17_RTC_CTRL_MODEL24	BIT(1)
@@ -48,8 +63,36 @@ struct s2mps17_rtc {
 	struct rtc_device *rtc;
 	/* UPDATE register without the request bits */
 	unsigned int update_base;
+	struct i2c_client *client;
+	struct mutex lock;
 };
 
+static int s2mps17_pmic_read(struct s2mps17_rtc *info, u8 reg, u8 *buf,
+			     u16 len)
+{
+	struct i2c_msg msgs[] = {
+		{ .addr = S2MPS17_PMIC_ADDR, .len = 1, .buf = &reg },
+		{ .addr = S2MPS17_PMIC_ADDR, .flags = I2C_M_RD, .len = len,
+		  .buf = buf },
+	};
+	int ret;
+
+	ret = i2c_transfer(info->client->adapter, msgs, ARRAY_SIZE(msgs));
+	return ret == ARRAY_SIZE(msgs) ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static int s2mps17_pmic_write(struct s2mps17_rtc *info, u8 reg, u8 val)
+{
+	u8 buf[] = { reg, val };
+	struct i2c_msg msg = {
+		.addr = S2MPS17_PMIC_ADDR, .len = sizeof(buf), .buf = buf,
+	};
+	int ret;
+
+	ret = i2c_transfer(info->client->adapter, &msg, 1);
+	return ret == 1 ? 0 : ret < 0 ? ret : -EIO;
+}
+
 static int s2mps17_rtc_update(struct s2mps17_rtc *info, unsigned int bit)
 {
 	int ret;
@@ -69,12 +112,38 @@ static int s2mps17_rtc_update(struct s2mps17_rtc *info, unsigned int bit)
 	return 0;
 }
 
+static void s2mps17_rtc_tm_to_data(const struct rtc_time *tm, u8 *data)
+{
+	data[RTC_SEC] = tm->tm_sec;
+	data[RTC_MIN] = tm->tm_min;
+	data[RTC_HOUR] = tm->tm_hour;
+	if (tm->tm_hour >= 12)
+		data[RTC_HOUR] |= S2MPS17_RTC_HOUR_PM;
+	data[RTC_WEEKDAY] = BIT(tm->tm_wday);
+	data[RTC_DATE] = tm->tm_mday;
+	data[RTC_MONTH] = tm->tm_mon + 1;
+	data[RTC_YEAR] = tm->tm_year - 100;
+}
+
+static void s2mps17_rtc_data_to_tm(const u8 *data, struct rtc_time *tm)
+{
+	tm->tm_sec = data[RTC_SEC] & 0x7f;
+	tm->tm_min = data[RTC_MIN] & 0x7f;
+	tm->tm_hour = data[RTC_HOUR] & 0x1f;
+	tm->tm_wday = data[RTC_WEEKDAY] & 0x7f ?
+		      __fls(data[RTC_WEEKDAY] & 0x7f) : 0;
+	tm->tm_mday = data[RTC_DATE] & 0x1f;
+	tm->tm_mon = (data[RTC_MONTH] & 0x0f) - 1;
+	tm->tm_year = (data[RTC_YEAR] & 0x7f) + 100;
+}
+
 static int s2mps17_rtc_read_time(struct device *dev, struct rtc_time *tm)
 {
 	struct s2mps17_rtc *info = dev_get_drvdata(dev);
 	u8 data[RTC_NR_REGS];
 	int ret;
 
+	guard(mutex)(&info->lock);
 	ret = s2mps17_rtc_update(info, S2MPS17_RTC_UPDATE_RUDR);
 	if (ret)
 		return ret;
@@ -84,15 +153,7 @@ static int s2mps17_rtc_read_time(struct device *dev, struct rtc_time *tm)
 	if (ret)
 		return ret;
 
-	tm->tm_sec = data[RTC_SEC] & 0x7f;
-	tm->tm_min = data[RTC_MIN] & 0x7f;
-	tm->tm_hour = data[RTC_HOUR] & 0x1f;
-	tm->tm_wday = data[RTC_WEEKDAY] & 0x7f ?
-		      __fls(data[RTC_WEEKDAY] & 0x7f) : 0;
-	tm->tm_mday = data[RTC_DATE] & 0x1f;
-	tm->tm_mon = (data[RTC_MONTH] & 0x0f) - 1;
-	tm->tm_year = (data[RTC_YEAR] & 0x7f) + 100;
-
+	s2mps17_rtc_data_to_tm(data, tm);
 	return 0;
 }
 
@@ -105,16 +166,9 @@ static int s2mps17_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	if (tm->tm_year < 100 || tm->tm_year > 227)
 		return -EINVAL;
 
-	data[RTC_SEC] = tm->tm_sec;
-	data[RTC_MIN] = tm->tm_min;
-	data[RTC_HOUR] = tm->tm_hour;
-	if (tm->tm_hour >= 12)
-		data[RTC_HOUR] |= S2MPS17_RTC_HOUR_PM;
-	data[RTC_WEEKDAY] = BIT(tm->tm_wday);
-	data[RTC_DATE] = tm->tm_mday;
-	data[RTC_MONTH] = tm->tm_mon + 1;
-	data[RTC_YEAR] = tm->tm_year - 100;
+	s2mps17_rtc_tm_to_data(tm, data);
 
+	guard(mutex)(&info->lock);
 	ret = regmap_bulk_write(info->regmap, S2MPS17_RTC_REG_SEC, data,
 				sizeof(data));
 	if (ret)
@@ -123,11 +177,139 @@ static int s2mps17_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	return s2mps17_rtc_update(info, S2MPS17_RTC_UPDATE_WUDR);
 }
 
+static int s2mps17_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *alrm)
+{
+	struct s2mps17_rtc *info = dev_get_drvdata(dev);
+	u8 data[RTC_NR_REGS];
+	int ret;
+
+	guard(mutex)(&info->lock);
+	ret = s2mps17_rtc_update(info, S2MPS17_RTC_UPDATE_RUDR);
+	if (ret)
+		return ret;
+
+	ret = regmap_bulk_read(info->regmap, S2MPS17_RTC_REG_A0SEC, data,
+			       sizeof(data));
+	if (ret)
+		return ret;
+
+	s2mps17_rtc_data_to_tm(data, &alrm->time);
+	alrm->enabled = !!(data[RTC_SEC] & S2MPS17_RTC_ALARM_EN);
+
+	return 0;
+}
+
+/* the alarm fires when all fields with their enable bit set match */
+static int s2mps17_rtc_write_alarm(struct s2mps17_rtc *info, u8 *data,
+				   bool enabled)
+{
+	int i, ret;
+
+	for (i = 0; i < RTC_NR_REGS; i++) {
+		if (enabled)
+			data[i] |= S2MPS17_RTC_ALARM_EN;
+		else
+			data[i] &= ~S2MPS17_RTC_ALARM_EN;
+	}
+
+	ret = regmap_bulk_write(info->regmap, S2MPS17_RTC_REG_A0SEC, data,
+				RTC_NR_REGS);
+	if (ret)
+		return ret;
+
+	return s2mps17_rtc_update(info, S2MPS17_RTC_UPDATE_AUDR);
+}
+
+static int s2mps17_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alrm)
+{
+	struct s2mps17_rtc *info = dev_get_drvdata(dev);
+	u8 data[RTC_NR_REGS];
+	int ret;
+
+	s2mps17_rtc_tm_to_data(&alrm->time, data);
+
+	guard(mutex)(&info->lock);
+	/* disarm first, so that a half-written time can't match */
+	ret = s2mps17_rtc_write_alarm(info, data, false);
+	if (ret || !alrm->enabled)
+		return ret;
+
+	return s2mps17_rtc_write_alarm(info, data, true);
+}
+
+static int s2mps17_rtc_alarm_irq_enable(struct device *dev, unsigned int enabled)
+{
+	struct s2mps17_rtc *info = dev_get_drvdata(dev);
+	u8 data[RTC_NR_REGS];
+	int ret;
+
+	guard(mutex)(&info->lock);
+	ret = s2mps17_rtc_update(info, S2MPS17_RTC_UPDATE_RUDR);
+	if (ret)
+		return ret;
+
+	ret = regmap_bulk_read(info->regmap, S2MPS17_RTC_REG_A0SEC, data,
+			       sizeof(data));
+	if (ret)
+		return ret;
+
+	return s2mps17_rtc_write_alarm(info, data, enabled);
+}
+
+static irqreturn_t s2mps17_rtc_irq(int irq, void *dev_id)
+{
+	struct s2mps17_rtc *info = dev_id;
+	u8 ints[S2MPS17_PMIC_NR_INT];
+
+	/* reading the interrupt registers clears them */
+	if (s2mps17_pmic_read(info, S2MPS17_PMIC_REG_INT1, ints, sizeof(ints)))
+		return IRQ_NONE;
+
+	if (!(ints[S2MPS17_PMIC_REG_INT2] & S2MPS17_PMIC_INT2_RTCA0))
+		return IRQ_NONE;
+
+	rtc_update_irq(info->rtc, 1, RTC_IRQF | RTC_AF);
+	return IRQ_HANDLED;
+}
+
+static int s2mps17_rtc_setup_irq(struct s2mps17_rtc *info)
+{
+	struct device *dev = &info->client->dev;
+	u8 ints[S2MPS17_PMIC_NR_INT];
+	int i, ret;
+
+	/* only RTCA0, then drop what is pending */
+	for (i = 0; i < S2MPS17_PMIC_NR_INT; i++) {
+		ret = s2mps17_pmic_write(info, S2MPS17_PMIC_REG_INT1M + i,
+					 i == S2MPS17_PMIC_REG_INT2 ?
+					 (u8)~S2MPS17_PMIC_INT2_RTCA0 : 0xff);
+		if (ret)
+			return ret;
+	}
+	ret = s2mps17_pmic_read(info, S2MPS17_PMIC_REG_INT1, ints, sizeof(ints));
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, info->client->irq, NULL,
+					s2mps17_rtc_irq, IRQF_ONESHOT,
+					"rtc-alarm0", info);
+	/* "wakeup-source" makes the I2C core set it up as the wake IRQ */
+	return ret;
+}
+
 static const struct rtc_class_ops s2mps17_rtc_ops = {
 	.read_time = s2mps17_rtc_read_time,
 	.set_time = s2mps17_rtc_set_time,
 };
 
+static const struct rtc_class_ops s2mps17_rtc_alarm_ops = {
+	.read_time = s2mps17_rtc_read_time,
+	.set_time = s2mps17_rtc_set_time,
+	.read_alarm = s2mps17_rtc_read_alarm,
+	.set_alarm = s2mps17_rtc_set_alarm,
+	.alarm_irq_enable = s2mps17_rtc_alarm_irq_enable,
+};
+
 static const struct regmap_config s2mps17_rtc_regmap_config = {
 	.reg_bits = 8,
 	.val_bits = 8,
@@ -144,6 +326,10 @@ static int s2mps17_rtc_probe(struct i2c_client *client)
 	info = devm_kzalloc(dev, sizeof(*info), GFP_KERNEL);
 	if (!info)
 		return -ENOMEM;
+	info->client = client;
+	ret = devm_mutex_init(dev, &info->lock);
+	if (ret)
+		return ret;
 
 	info->regmap = devm_regmap_init_i2c(client, &s2mps17_rtc_regmap_config);
 	if (IS_ERR(info->regmap))
@@ -176,6 +362,13 @@ static int s2mps17_rtc_probe(struct i2c_client *client)
 	info->rtc->range_min = RTC_TIMESTAMP_BEGIN_2000;
 	info->rtc->range_max = RTC_TIMESTAMP_END_2099;
 
+	if (client->irq > 0) {
+		ret = s2mps17_rtc_setup_irq(info);
+		if (ret)
+			return dev_err_probe(dev, ret, "no alarm interrupt\n");
+		info->rtc->ops = &s2mps17_rtc_alarm_ops;
+	}
+
 	return devm_rtc_register_device(info->rtc);
 }
 
