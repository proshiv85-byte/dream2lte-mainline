diff --git a/mm/memfd-ashmem-shim.c b/mm/memfd-ashmem-shim.c
new file mode 100644
index 000000000..3c7ece295
--- /dev/null
+++ b/mm/memfd-ashmem-shim.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ashmem ioctl compatibility for memfd files.
+ *
+ * Android's libcutils only uses memfd for shared memory when the kernel
+ * answers the old ashmem ioctls on memfds (vendor code still issues them);
+ * otherwise it falls back to /dev/ashmem, which mainline no longer has.
+ * This gives memfds (shmem backed, not hugetlb) the ioctls that make sense
+ * for them: size, name, protection mask (mapped onto write seals), and
+ * pinning as a no-op (memfd memory is never purged).
+ *
+ * Note: the memfd gets a copy of shmem's file_operations, so the
+ * VM_BUG_ON(f_op != &shmem_file_operations) in shmem_get_unmapped_area()
+ * would fire with CONFIG_DEBUG_VM; do not enable both.
+ */
+#include <linux/fs.h>
+#include <linux/memfd.h>
+#include <linux/mman.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/compat.h>
+#include <uapi/linux/fcntl.h>
+
+#define ASHMEM_NAME_LEN		256
+#define ASHMEM_NAME_PREFIX	"memfd:"
+#define ASHMEM_NOT_PURGED	0
+#define ASHMEM_IS_PINNED	1
+
+#define __ASHMEMIOC		0x77
+#define ASHMEM_SET_NAME		_IOW(__ASHMEMIOC, 1, char[ASHMEM_NAME_LEN])
+#define ASHMEM_GET_NAME		_IOR(__ASHMEMIOC, 2, char[ASHMEM_NAME_LEN])
+#define ASHMEM_SET_SIZE		_IOW(__ASHMEMIOC, 3, size_t)
+#define ASHMEM_GET_SIZE		_IO(__ASHMEMIOC, 4)
+#define ASHMEM_SET_PROT_MASK	_IOW(__ASHMEMIOC, 5, unsigned long)
+#define ASHMEM_GET_PROT_MASK	_IO(__ASHMEMIOC, 6)
+#define ASHMEM_PIN		_IOW(__ASHMEMIOC, 7, struct ashmem_pin)
+#define ASHMEM_UNPIN		_IOW(__ASHMEMIOC, 8, struct ashmem_pin)
+#define ASHMEM_GET_PIN_STATUS	_IO(__ASHMEMIOC, 9)
+#define ASHMEM_PURGE_ALL_CACHES	_IO(__ASHMEMIOC, 10)
+#define ASHMEM_GET_FILE_ID	_IOR(__ASHMEMIOC, 11, unsigned long)
+
+struct ashmem_pin {
+	__u32 offset;
+	__u32 len;
+};
+
+static long memfd_ashmem_ioctl(struct file *file, unsigned int cmd,
+			       unsigned long arg)
+{
+	struct inode *inode = file_inode(file);
+	int seals;
+
+	switch (cmd) {
+	case ASHMEM_GET_SIZE:
+		return i_size_read(inode);
+	case ASHMEM_SET_SIZE:
+		/* sized with ftruncate() for memfds; accept a no-op resize */
+		return arg == i_size_read(inode) ? 0 : -EINVAL;
+	case ASHMEM_GET_PROT_MASK:
+		seals = memfd_get_seals(file);
+		if (seals < 0)
+			return seals;
+		if (seals & (F_SEAL_WRITE | F_SEAL_FUTURE_WRITE))
+			return PROT_READ | PROT_EXEC;
+		return PROT_READ | PROT_WRITE | PROT_EXEC;
+	case ASHMEM_SET_PROT_MASK:
+		if (arg & PROT_WRITE)
+			return 0;
+		return memfd_add_seals(file, F_SEAL_FUTURE_WRITE);
+	case ASHMEM_GET_NAME: {
+		char name[ASHMEM_NAME_LEN] = { 0 };
+		const char *dname = file->f_path.dentry->d_name.name;
+
+		if (str_has_prefix(dname, ASHMEM_NAME_PREFIX))
+			dname += strlen(ASHMEM_NAME_PREFIX);
+		strscpy(name, dname, sizeof(name));
+		if (copy_to_user((void __user *)arg, name, strlen(name) + 1))
+			return -EFAULT;
+		return 0;
+	}
+	case ASHMEM_SET_NAME:
+		/* the name is given at memfd_create() time */
+		return 0;
+	case ASHMEM_PIN:
+		return ASHMEM_NOT_PURGED;
+	case ASHMEM_UNPIN:
+		return 0;
+	case ASHMEM_GET_PIN_STATUS:
+		return ASHMEM_IS_PINNED;
+	case ASHMEM_PURGE_ALL_CACHES:
+		return 0;
+	case ASHMEM_GET_FILE_ID: {
+		unsigned long ino = inode->i_ino;
+
+		if (copy_to_user((void __user *)arg, &ino, sizeof(ino)))
+			return -EFAULT;
+		return 0;
+	}
+	}
+	return -ENOTTY;
+}
+
+#ifdef CONFIG_COMPAT
+static long memfd_ashmem_compat_ioctl(struct file *file, unsigned int cmd,
+				      unsigned long arg)
+{
+	/* the 32-bit size_t/unsigned long variants differ only in size bits */
+	switch (cmd) {
+	case _IOW(__ASHMEMIOC, 3, compat_size_t):
+		cmd = ASHMEM_SET_SIZE;
+		break;
+	case _IOW(__ASHMEMIOC, 5, compat_ulong_t):
+		cmd = ASHMEM_SET_PROT_MASK;
+		break;
+	case _IOR(__ASHMEMIOC, 11, compat_ulong_t):
+		return -ENOTTY;
+	}
+	return memfd_ashmem_ioctl(file, cmd, (unsigned long)compat_ptr(arg));
+}
+#endif
+
+static struct file_operations memfd_ashmem_fops;
+static const struct file_operations *memfd_ashmem_base;
+static DEFINE_MUTEX(memfd_ashmem_lock);
+
+struct file *memfd_ashmem_shim(struct file *file)
+{
+	mutex_lock(&memfd_ashmem_lock);
+	if (!memfd_ashmem_base) {
+		memfd_ashmem_fops = *file->f_op;
+		memfd_ashmem_fops.unlocked_ioctl = memfd_ashmem_ioctl;
+#ifdef CONFIG_COMPAT
+		memfd_ashmem_fops.compat_ioctl = memfd_ashmem_compat_ioctl;
+#endif
+		memfd_ashmem_base = file->f_op;
+	}
+	mutex_unlock(&memfd_ashmem_lock);
+
+	/* only ever wrap the shmem fops the copy was made from */
+	if (file->f_op == memfd_ashmem_base)
+		file->f_op = &memfd_ashmem_fops;
+	return file;
+}
diff --git a/mm/memfd.c b/mm/memfd.c
index c708d9253..8fb97ef82 100644
--- a/mm/memfd.c
+++ b/mm/memfd.c
@@ -467,6 +467,10 @@ struct file *memfd_alloc_file(const char *name, unsigned int flags)
 					MFD_HUGE_MASK);
 	} else {
 		file = shmem_file_setup(name, 0, mk_vma_flags(VMA_NORESERVE_BIT));
+#ifdef CONFIG_MEMFD_ASHMEM_SHIM
+		if (!IS_ERR(file))
+			file = memfd_ashmem_shim(file);
+#endif
 	}
 	if (IS_ERR(file))
 		return file;
