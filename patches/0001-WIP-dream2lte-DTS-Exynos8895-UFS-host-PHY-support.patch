diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
new file mode 100644
index 000000000..55112c2c1
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy S8+ (dream2lte/SM-G955F) device tree source
+ *
+ * Based on exynos8895-dreamlte.dts,
+ * Copyright (c) 2024, Ivaylo Ivanov <ivo.ivanov.ivanov1@gmail.com>
+ */
+
+/dts-v1/;
+#include "exynos8895.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/soc/samsung,exynos-usi.h>
+
+/ {
+	model = "Samsung Galaxy S8+ (SM-G955F)";
+	compatible = "samsung,dream2lte", "samsung,exynos8895";
+	chassis-type = "handset";
+
+	aliases {
+		mmc0 = &mmc;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		framebuffer: framebuffer@cc000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0xcc000000 (1440 * 2960 * 4)>;
+			width = <1440>;
+			height = <2960>;
+			stride = <(1440 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3c800000>,
+		      <0x0 0xc0000000 0x40000000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Same location and layout as the "log_pstore" item of the
+		 * vendor kernel's exynos-snapshot, so the console log can be
+		 * read back from the vendor kernel (and TWRP) as pmsg-ramoops-0.
+		 */
+		ramoops@92000000 {
+			compatible = "ramoops";
+			reg = <0 0x92000000 0x8000>;
+			record-size = <0x4000>;
+			console-size = <0x4000>;
+		};
+
+		tima@b1000000 {
+			reg = <0 0xb1000000 0x200000>;
+			no-map;
+		};
+
+		seclog@c0000000 {
+			reg = <0 0xc0000000 0x10000>;
+			no-map;
+		};
+
+		cont_splash_mem: framebuffer@cc000000 {
+			reg = <0 0xcc000000 (1440 * 2960 * 4)>;
+			no-map;
+		};
+
+		/*
+		 * Carve-outs of the vendor firmware, some of them are protected
+		 * by the secure world. Any access from Linux faults.
+		 */
+		secure_camera@d0000000 {
+			reg = <0 0xd0000000 0x1400000>;
+			no-map;
+		};
+
+		video_stream@e3c00000 {
+			reg = <0 0xe3c00000 0x3800000>;
+			no-map;
+		};
+
+		tui@e7400000 {
+			reg = <0 0xe7400000 0x3400000>;
+			no-map;
+		};
+
+		abox@ea800000 {
+			reg = <0 0xea800000 0x400000>;
+			no-map;
+		};
+
+		crypto@f3400000 {
+			reg = <0 0xf3400000 0x1800000>;
+			no-map;
+		};
+
+		modem_if@f4c00000 {
+			reg = <0 0xf4c00000 0x9000000>;
+			no-map;
+		};
+
+		cp_ram_logging@fdc00000 {
+			reg = <0 0xfdc00000 0x2000000>;
+			no-map;
+		};
+
+		gnss_if@ffc00000 {
+			reg = <0 0xffc00000 0x400000>;
+			no-map;
+		};
+	};
+
+	ufs_vcc: regulator-ufs-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "ufs-vcc";
+		gpio = <&gpg0 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_power &key_voldown &key_volup &key_wink>;
+		pinctrl-names = "default";
+
+		power-key {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		voldown-key {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;
+		};
+
+		volup-key {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
+		};
+
+		/* Typically used for Bixby. Map it as a camera button for now */
+		wink-key {
+			label = "Camera";
+			linux,code = <KEY_CAMERA>;
+			gpios = <&gpa0 6 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&pinctrl_alive {
+	key_power: key-power-pins {
+		samsung,pins = "gpa2-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa0-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	key_wink: key-wink-pins {
+		samsung,pins = "gpa0-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+};
+
+&ufs {
+	vcc-supply = <&ufs_vcc>;
+	vcc-fixed-regulator;
+
+	status = "okay";
+};
+
+&ufs_phy {
+	status = "okay";
+};
+
+&pmu_system_controller {
+	reboot: syscon-reboot {
+		compatible = "syscon-reboot";
+		offset = <0x400>; /* SWRESET */
+		mask = <0x1>;
+		value = <0x1>;
+	};
+
+	/* S-Boot reads the reboot reason from INFORM3 */
+	reboot-mode {
+		compatible = "syscon-reboot-mode";
+		offset = <0x80c>;
+		mode-normal = <0x12345670>;
+		mode-bootloader = <0x1234567d>;
+		mode-download = <0x12345671>;
+		mode-recovery = <0x12345674>;
+	};
+};
