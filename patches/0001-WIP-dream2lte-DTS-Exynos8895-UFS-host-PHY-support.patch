+#define EXYNOS8895_SMC_CMD_FMP_SECURITY	\
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64, \
+			   ARM_SMCCC_OWNER_SIP, 0x1810)
+#define EXYNOS8895_SMC_CMD_SMU		\
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_SMC_64, \
+			   ARM_SMCCC_OWNER_SIP, 0x1830)
+#define EXYNOS8895_SMU_EMBEDDED		0
+#define EXYNOS8895_SMU_INIT		0
+#define EXYNOS8895_FMP_DESCTYPE_0	0
+/* Override of the PHY PCS attributes; the PA_DBG_OV_TM of this SoC */
+#define EXYNOS8895_PCS_OV_TM		0x200
+#define EXYNOS8895_RX_MIN_ACTV_TIME_CAP	0x3
+#define EXYNOS8895_UFS_TCXO_SEL		0x1150
+#define EXYNOS8895_PMU_UFS_OPTION	0x620
+#define HCI_UFS_ACG_DISABLE		0xFC
+#define HCI_UFS_ACG_DISABLE_EN		BIT(0)
+#define HCI_MPHY_REFCLK_SEL		0x108
+#define MPHY_REFCLK_SEL			BIT(0)
+
+static int exynos8895_ufs_drv_init(struct exynos_ufs *ufs)
+{
+	struct ufs_hba *hba = ufs->hba;
+	struct arm_smccc_res res;
+	struct regmap *pmu;
+	u32 reg;
+
+	/*
+	 * The UFS protector is configured by the secure world: use plain
+	 * PRDT entries (descriptor type 0) and let it initialize the SMU.
+	 */
+	arm_smccc_smc(EXYNOS8895_SMC_CMD_FMP_SECURITY, 0,
+		      EXYNOS8895_SMU_EMBEDDED, EXYNOS8895_FMP_DESCTYPE_0,
+		      0, 0, 0, 0, &res);
+	if (res.a0)
+		dev_warn(hba->dev, "SMC_CMD_FMP_SECURITY failed: %ld\n", res.a0);
+
+	arm_smccc_smc(EXYNOS8895_SMC_CMD_SMU, EXYNOS8895_SMU_INIT,
+		      EXYNOS8895_SMU_EMBEDDED, 0, 0, 0, 0, 0, &res);
+	if (res.a0)
+		dev_warn(hba->dev, "SMC_CMD_SMU(SMU_INIT) failed: %ld\n", res.a0);
+
+	pmu = syscon_regmap_lookup_by_compatible("samsung,exynos8895-pmu");
+	if (!IS_ERR(pmu)) {
+		regmap_read(pmu, EXYNOS8895_PMU_UFS_OPTION, &reg);
+		dev_dbg(hba->dev, "PMU UFS option: %#x\n", reg);
+		regmap_update_bits(pmu, EXYNOS8895_PMU_UFS_OPTION, BIT(0),
+				   BIT(0));
+	}
+
+	/* Use the TCXO as the reference clock */
+	if (ufs->sysreg)
+		regmap_update_bits(ufs->sysreg, EXYNOS8895_UFS_TCXO_SEL,
+				   BIT(0), BIT(0));
+
+	/* set ACG to be controlled by UFS_ACG_DISABLE */
+	reg = hci_readl(ufs, HCI_IOP_ACG_DISABLE);
+	hci_writel(ufs, reg & ~HCI_IOP_ACG_DISABLE_EN, HCI_IOP_ACG_DISABLE);
+
+	return exynos_ufs_shareability(ufs);
+}
+
+static int exynos8895_ufs_pre_link(struct exynos_ufs *ufs)
+{
+	struct ufs_hba *hba = ufs->hba;
+	u32 pclk_period = UNIPRO_PCLK_PERIOD(ufs);
+	int i;
+
+	/* The lane loops below run before exynos_ufs_phy_init() */
+	if (!ufs->avail_ln_rx || !ufs->avail_ln_tx) {
+		ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILRXDATALANES),
+			       &ufs->avail_ln_rx);
+		ufshcd_dme_get(hba, UIC_ARG_MIB(PA_AVAILTXDATALANES),
+			       &ufs->avail_ln_tx);
+	}
+
+	/* M-PHY reference clock from the alternative (TCXO) path */
+	hci_writel(ufs, hci_readl(ufs, HCI_MPHY_REFCLK_SEL) | MPHY_REFCLK_SEL,
+		   HCI_MPHY_REFCLK_SEL);
+	/* Disable hardware auto clock gating */
+	hci_writel(ufs, hci_readl(ufs, HCI_UFS_ACG_DISABLE) |
+		   HCI_UFS_ACG_DISABLE_EN, HCI_UFS_ACG_DISABLE);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(EXYNOS8895_PCS_OV_TM), 0x40);
+
+	for_each_ufs_rx_lane(ufs, i)
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x12, i), pclk_period);
+	for_each_ufs_tx_lane(ufs, i)
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0xAA, i), pclk_period);
+
+	for_each_ufs_rx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x5C, i), 0x38);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x0F, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x65, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x69, i), 0x1);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x21, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x22, i), 0x0);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x84, i), 0x1);
+	}
+
+	/* TX PWM Gear Capability / PWM_G1_ONLY */
+	for_each_ufs_tx_lane(ufs, i)
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x04, i), 0x1);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(EXYNOS8895_PCS_OV_TM), 0x0);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_DBG_AUTOMODE_THLD), 0x4E20);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_DBG_OPTION_SUITE), 0x2e820183);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_LOCAL_TX_LCC_ENABLE), 0x0);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(N_DEVICEID), 0x0);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(N_DEVICEID_VALID), 0x1);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(T_PEERDEVICEID), 0x1);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(T_CONNECTIONSTATE), CPORT_CONNECTED);
+
+	return 0;
+}
+
+static int exynos8895_ufs_post_link(struct exynos_ufs *ufs)
+{
+	struct ufs_hba *hba = ufs->hba;
+	u32 peer_rx_min_actv_time_cap;
+	u32 max_rx_hibern8_time_cap;
+	int i;
+
+	/* 1us tick of the interrupt aggregation timer, from the mclk */
+	hci_writel(ufs, (ufs->mclk_rate / USEC_PER_SEC) & CNT_VAL_1US_MASK,
+		   HCI_1US_TO_CNT_VAL);
+	hci_writel(ufs, WLU_EN | WLU_BURST_LEN(3), HCI_AXIDMA_RWDATA_BURST_LEN);
+
+	ufshcd_dme_get(hba, UIC_ARG_MIB(PA_TACTIVATE),
+		       &peer_rx_min_actv_time_cap);
+	ufshcd_dme_get(hba, UIC_ARG_MIB(PA_HIBERN8TIME),
+		       &max_rx_hibern8_time_cap);
+	if (peer_rx_min_actv_time_cap >= EXYNOS8895_RX_MIN_ACTV_TIME_CAP)
+		ufshcd_dme_peer_set(hba, UIC_ARG_MIB(PA_TACTIVATE),
+				    peer_rx_min_actv_time_cap + 1);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_HIBERN8TIME),
+		       max_rx_hibern8_time_cap + 1);
+
+	exynos_ufs_enable_dbg_mode(hba);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_SAVECONFIGTIME), 0xFA);
+	exynos_ufs_disable_dbg_mode(hba);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(EXYNOS8895_PCS_OV_TM), 0x40);
+	for_each_ufs_rx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x35, i), 0x05);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x73, i), 0x01);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x41, i), 0x02);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x42, i), 0xAC);
+	}
+	ufshcd_dme_set(hba, UIC_ARG_MIB(EXYNOS8895_PCS_OV_TM), 0x0);
+
+	return 0;
+}
+
+static int exynos8895_ufs_pre_pwr_change(struct exynos_ufs *ufs,
+					 struct ufs_pa_layer_attr *pwr)
+{
+	struct ufs_hba *hba = ufs->hba;
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_TXTERMINATION), 0x1);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_RXTERMINATION), 0x1);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA0), 12000);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA1), 32000);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_PWRMODEUSERDATA2), 16000);
+
+	unipro_writel(ufs, 8064, UNIPRO_DME_POWERMODE_REQ_LOCALL2TIMER0);
+	unipro_writel(ufs, 28224, UNIPRO_DME_POWERMODE_REQ_LOCALL2TIMER1);
+	unipro_writel(ufs, 20160, UNIPRO_DME_POWERMODE_REQ_LOCALL2TIMER2);
+	unipro_writel(ufs, 12000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER0);
+	unipro_writel(ufs, 32000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER1);
+	unipro_writel(ufs, 16000, UNIPRO_DME_POWERMODE_REQ_REMOTEL2TIMER2);
+
+	return 0;
+}
