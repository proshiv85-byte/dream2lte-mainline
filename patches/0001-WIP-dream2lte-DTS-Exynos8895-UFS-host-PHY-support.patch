diff --git a/drivers/phy/samsung/phy-exynos8895-ufs.c b/drivers/phy/samsung/phy-exynos8895-ufs.c
new file mode 100644
index 000000000..a56b323f1
--- /dev/null
+++ b/drivers/phy/samsung/phy-exynos8895-ufs.c
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UFS PHY driver data for Samsung Exynos8895 SoC
+ *
+ * Calibration values taken from the Samsung vendor kernel's device tree
+ * (exynos8895.dtsi: phy-init, calib-of-hs-rate-b, post-calib-of-hs-rate-b).
+ */
+
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+
+#include "phy-samsung-ufs.h"
+
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL	0x724
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_MASK	0x1
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_EN	BIT(0)
+
+/* The lanes of the transceiver block are 0x50 registers apart */
+#define EXYNOS8895_PHY_TRSV_CH_OFFSET		0x50
+#define EXYNOS8895_PHY_CDR_LOCK_STATUS		0x7f
+#define EXYNOS8895_PHY_CDR_LOCK_BIT		BIT(0)
+
+#define PHY_EXYNOS8895_TRSV_REG_CFG(o, v, d) \
+	PHY_TRSV_REG_CFG_OFFSET(o, v, d, EXYNOS8895_PHY_TRSV_CH_OFFSET)
+
+/* Calibration for phy initialization */
+static const struct samsung_ufs_phy_cfg exynos8895_pre_init_cfg[] = {
+	PHY_COMN_REG_CFG(0x023, 0x80, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x01d, 0x10, PWR_MODE_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x044, 0xb5, PWR_MODE_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x04d, 0x43, PWR_MODE_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x05b, 0x20, PWR_MODE_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x05e, 0xc0, PWR_MODE_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x038, 0x12, PWR_MODE_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x059, 0x58, PWR_MODE_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x023, 0xc0, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x023, 0x00, PWR_MODE_ANY),
+	END_UFS_PHY_CFG
+};
+
+/* Calibration for HS mode series A/B, values for HS-G3 */
+static const struct samsung_ufs_phy_cfg exynos8895_pre_pwr_hs_cfg[] = {
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x032, 0xbc, PWR_MODE_HS_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x03c, 0x7f, PWR_MODE_HS_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x048, 0xc0, PWR_MODE_HS_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x04a, 0x00, PWR_MODE_HS_G3_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x04b, 0x00, PWR_MODE_HS_G3_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x04d, 0x63, PWR_MODE_HS_G3_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x042, 0x5d, PWR_MODE_HS_ANY),
+	PHY_EXYNOS8895_TRSV_REG_CFG(0x043, 0x90, PWR_MODE_HS_ANY),
+	END_UFS_PHY_CFG
+};
+
+/* Calibration for HS mode series A/B after PMC */
+static const struct samsung_ufs_phy_cfg exynos8895_post_pwr_hs_cfg[] = {
+	END_UFS_PHY_CFG
+};
+
+static const struct samsung_ufs_phy_cfg *exynos8895_ufs_phy_cfgs[CFG_TAG_MAX] = {
+	[CFG_PRE_INIT]		= exynos8895_pre_init_cfg,
+	[CFG_PRE_PWR_HS]	= exynos8895_pre_pwr_hs_cfg,
+	[CFG_POST_PWR_HS]	= exynos8895_post_pwr_hs_cfg,
+};
+
+static int exynos8895_ufs_phy_wait_for_cal(struct phy *phy, u8 lane)
+{
+	/* The PMA needs 200us to settle after the initial calibration */
+	if (lane == 0)
+		udelay(200);
+
+	return 0;
+}
+
+static int exynos8895_ufs_phy_wait_cdr_lock(struct phy *phy, u8 lane)
+{
+	struct samsung_ufs_phy *ufs_phy = get_samsung_ufs_phy(phy);
+	u32 val;
+	int err;
+
+	/* Like the vendor kernel, only lane 0 is checked */
+	if (lane != 0)
+		return 0;
+
+	err = readl_poll_timeout(ufs_phy->reg_pma +
+				 PHY_APB_ADDR(EXYNOS8895_PHY_CDR_LOCK_STATUS),
+				 val, (val & EXYNOS8895_PHY_CDR_LOCK_BIT),
+				 10, 100000);
+	if (err)
+		dev_err(ufs_phy->dev,
+			"failed to get phy cdr lock acquisition %d\n", err);
+
+	return err;
+}
+
+const struct samsung_ufs_phy_drvdata exynos8895_ufs_phy = {
+	.cfgs = exynos8895_ufs_phy_cfgs,
+	.isol = {
+		.offset = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL,
+		.mask = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_MASK,
+		.en = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_EN,
+	},
+	.wait_for_cal = exynos8895_ufs_phy_wait_for_cal,
+	.wait_for_cdr = exynos8895_ufs_phy_wait_cdr_lock,
+};
