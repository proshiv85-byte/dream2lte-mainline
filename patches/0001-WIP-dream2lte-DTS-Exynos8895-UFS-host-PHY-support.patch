@@ -105,6 +105,10 @@
 #define UFS_GS101_RD_SHARABLE		BIT(0)
 #define UFS_GS101_SHARABLE		(UFS_GS101_WR_SHARABLE | \
 					 UFS_GS101_RD_SHARABLE)
+#define UFS_EXYNOS8895_WR_SHARABLE	BIT(9)
