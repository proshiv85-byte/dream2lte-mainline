+				 <&cmu_fsys0 CLK_GOUT_FSYS0_UFS_EMBD_I_CLK_UNIPRO>;
+			clock-names = "core_clk", "sclk_unipro_main";
+			freq-table-hz = <0 0>, <0 0>;
+			dma-coherent;
+			pinctrl-0 = <&ufs_rst_n &ufs_refclk_out>;
+			pinctrl-names = "default";
+			phys = <&ufs_phy>;
+			phy-names = "ufs-phy";
+			samsung,sysreg = <&syscon_fsys0 0x700>;
+
+			status = "disabled";
+		};
+
+		ufs_phy: phy@11124000 {
+			compatible = "samsung,exynos8895-ufs-phy";
+			reg = <0x11124000 0x800>;
+			reg-names = "phy-pma";
+			samsung,pmu-syscon = <&pmu_system_controller>;
+			#phy-cells = <0>;
+
+			status = "disabled";
+		};
+
 		cmu_fsys1: clock-controller@11400000 {
 			compatible = "samsung,exynos8895-cmu-fsys1";
 			reg = <0x11400000 0x8000>;
