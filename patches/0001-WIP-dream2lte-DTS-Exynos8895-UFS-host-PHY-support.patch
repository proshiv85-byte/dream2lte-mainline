+#define UNIPRO_DME_HIBERN8_ENTER_IND_RESULT	0x7868
+#define UNIPRO_DME_HIBERN8_EXIT_IND_RESULT	0x7878
+#define UNIPRO_DME_PWR_IND_RESULT		0x78EC
+
+/*
+ * The UPMCRS field of HCS only reads back PWR_OK on this host, the
+ * actual result of the request is reported by the UniPro block.
+ */
+static u8 exynos8895_ufs_get_upmcrs(struct ufs_hba *hba,
+				    const struct uic_command *cmd)
+{
+	struct exynos_ufs *ufs = ufshcd_get_variant(hba);
+
+	switch (cmd->command) {
+	case UIC_CMD_DME_SET:
+		return unipro_readl(ufs, UNIPRO_DME_PWR_IND_RESULT);
+	case UIC_CMD_DME_HIBER_ENTER:
+		return unipro_readl(ufs, UNIPRO_DME_HIBERN8_ENTER_IND_RESULT);
+	case UIC_CMD_DME_HIBER_EXIT:
+		return unipro_readl(ufs, UNIPRO_DME_HIBERN8_EXIT_IND_RESULT);
+	default:
+		return (ufshcd_readl(hba, REG_CONTROLLER_STATUS) >> 8) & 0x7;
+	}
+}
