From eba756cc1e12847a53f21f8cdda52f656b52d72f Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sat, 24 Oct 2026 09:39:30 +0300
Subject: [PATCH 32/32] WIP: arm64: dts: exynos8895-dream2lte: USB-C role
 switching and host mode

Add the S2MM005 Type-C controller on HSI2C30 (USI12), the charger's
OTG VBUS regulator and a USB-C connector graph to DWC3, which now
switches roles (default: peripheral).

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 .../boot/dts/exynos/exynos8895-dream2lte.dts  | 64 ++++++++++++++++++-
 1 file changed, 63 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
index 0eae22a7c..a3f982ebf 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
@@ -367,6 +367,12 @@ charger: charger@69 {
 		compatible = "maxim,max77865-charger";
 		reg = <0x69>;
 		monitored-battery = <&battery>;
+
+		otg_vbus: usb-otg-vbus {
+			regulator-name = "usb_otg_vbus";
+			regulator-min-microvolt = <5000000>;
+			regulator-max-microvolt = <5000000>;
+		};
 	};
 };
 
@@ -391,6 +397,12 @@ sd2_cd: sd2-cd-pins {
 		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV4>;
 	};
 
+	usbpd_irq: usbpd-irq-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+	};
+
 	key_power: key-power-pins {
 		samsung,pins = "gpa2-4";
 		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
@@ -505,6 +517,48 @@ &usi1 {
 	status = "okay";
 };
 
+&usi12 {
+	samsung,mode = <USI_MODE_I2C0_1>;
+
+	status = "okay";
+};
+
+&hsi2c_30 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	typec@33 {
+		compatible = "samsung,s2mm005";
+		reg = <0x33>;
+		interrupt-parent = <&gpa1>;
+		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
+		pinctrl-0 = <&usbpd_irq>;
+		pinctrl-names = "default";
+		vbus-supply = <&otg_vbus>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			data-role = "dual";
+			power-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					usbc_hs: endpoint {
+						remote-endpoint = <&dwc3_hs>;
+					};
+				};
+			};
+		};
+	};
+};
+
 &usi9 {
 	samsung,mode = <USI_MODE_I2C0_1>;
 
@@ -522,8 +576,16 @@ &usbdrd {
 };
 
 &usbdrd_dwc3 {
-	dr_mode = "peripheral";
+	dr_mode = "otg";
 	maximum-speed = "high-speed";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+
+	port {
+		dwc3_hs: endpoint {
+			remote-endpoint = <&usbc_hs>;
+		};
+	};
 };
 
 &usbdrd_phy {
