+		pcie_wifi0: pcie@116a0000 {
+			compatible = "samsung,exynos8895-pcie";
+			reg = <0x116a0000 0x1000>,
+			      <0x116c0000 0x200>,
+			      <0x116d0000 0x1000>,
+			      <0x11700000 0x1000>,
+			      <0x11aff000 0x1000>;
+			reg-names = "elbi", "pcs", "phy", "dbi", "config";
+			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_DBI_ACLK_0>,
+				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_MSTR_ACLK_0>,
+				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_SLV_ACLK_0>,
+				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_PCIE_SUB_CTRL_INST_0_I_DRIVER_APB_CLK>,
+				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_PIPE2_DIGITAL_X2_WRAP_INST_0_I_APB_PCLK_SCL>,
+				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_IEEE1500_WRAPPER_FOR_PCIE_PHY_LC_X2_INST_0_I_SCL_APB_PCLK>,
+				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_PHY_REF_CLK_IN>;
+			interrupts = <GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>;
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 0>;
+			interrupt-map = <0 0 0 0 &gic GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>;
+			samsung,pmu-syscon = <&pmu_system_controller>;
+			samsung,sysreg = <&syscon_fsys1 0x1044>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			bus-range = <0x00 0xff>;
+			/*
+			 * The slave window of this channel is 0x11800000-0x11bfffff.
+			 * The prefetchable part takes BARs that don't fit and are
+			 * clipped by the driver, the rest is moved up on the bus.
+			 */
+			ranges = <0xc2000000 0x0 0x11800000 0x11800000 0x0 0x2ff000>,
+				 <0x82000000 0x0 0x11c00000 0x11b00000 0x0 0x100000>;
+			num-lanes = <1>;
