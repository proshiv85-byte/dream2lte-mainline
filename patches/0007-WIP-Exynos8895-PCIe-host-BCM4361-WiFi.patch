 arch/arm64/boot/dts/exynos/exynos8895.dtsi    |  38 ++
 .../broadcom/brcm80211/brcmfmac/chip.c        |   1 +
 .../broadcom/brcm80211/brcmfmac/pcie.c        |   3 +
 .../broadcom/brcm80211/include/brcm_hw_ids.h  |   2 +
 drivers/pci/controller/dwc/Kconfig            |  11 +
 drivers/pci/controller/dwc/Makefile           |   1 +
 drivers/pci/controller/dwc/pcie-exynos8895.c  | 458 ++++++++++++++++++
 8 files changed, 559 insertions(+)
 create mode 100644 drivers/pci/controller/dwc/pcie-exynos8895.c

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
index 672ac1207..3bed252cf 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
@@ -130,6 +130,19 @@ ufs_vcc: regulator-ufs-vcc {
 		regulator-always-on;
 	};
 
+	wlan_pwr: regulator-wlan {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpj1 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		/* the vendor driver waits this long after WLAN_REG_ON */
+		startup-delay-us = <200000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en>;
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -206,6 +219,15 @@ &oscclk {
 	clock-frequency = <26000000>;
 };
 
+&pcie_wifi0 {
+	reset-gpios = <&gpj1 2 GPIO_ACTIVE_LOW>;
+	vpcie3v3-supply = <&wlan_pwr>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_clkreq &pcie0_perst>;
+
+	status = "okay";
+};
+
 &pinctrl_alive {
 	key_power: key-power-pins {
 		samsung,pins = "gpa2-4";
@@ -332,3 +354,26 @@ reboot-mode {
 		mode-recovery = <0x12345674>;
 	};
 };
+
+&pinctrl_fsys1 {
+	pcie0_clkreq: pcie0-clkreq-pins {
+		samsung,pins = "gpj1-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <3>;
+	};
+
+	pcie0_perst: pcie0-perst-pins {
+		samsung,pins = "gpj1-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <3>;
+	};
+
+	wlan_en: wlan-en-pins {
+		samsung,pins = "gpj1-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <3>;
+	};
+};
