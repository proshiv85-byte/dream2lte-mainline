From 789bd72872c0e6022c1c86652555475ce3660ba1 Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sat, 24 Oct 2026 08:52:46 +0300
Subject: [PATCH 29/32] WIP: arm64: dts: exynos8895-dream2lte: add Bluetooth

The BCM4361 Bluetooth is on UART1 (with RTS/CTS): BT_REG_ON on gpj1-7,
device wake on gpj1-4, host wake on gpa2-3.

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 .../arm64/boot/dts/exynos/exynos8895-dream2lte.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
index 6a2898c82..0eae22a7c 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
@@ -427,6 +427,20 @@ key_wink: key-wink-pins {
 	};
 };
 
+&serial_1 {
+	pinctrl-0 = <&uart1_bus &bt_hostwake &bt_btwake &bt_en>;
+
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm4361-bt";
+		shutdown-gpios = <&gpj1 7 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&gpj1 4 GPIO_ACTIVE_HIGH>;
+		host-wakeup-gpios = <&gpa2 3 GPIO_ACTIVE_HIGH>;
+		max-speed = <3000000>;
+	};
+};
+
 &spi_3 {
 	cs-gpios = <&gpd1 6 GPIO_ACTIVE_LOW>;
 	pinctrl-0 = <&spi3_bus &spi3_cs>;
