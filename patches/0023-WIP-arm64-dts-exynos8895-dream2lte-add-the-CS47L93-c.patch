From dccc146bc15dbfdb9f5f32c2edfe21af790abd4b Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sat, 24 Oct 2026 08:35:08 +0300
Subject: [PATCH 23/25] WIP: arm64: dts: exynos8895-dream2lte: add the CS47L93
 codec and sound card

The Cirrus CS47L93 codec is on SPI3 (USI1), powered by LDO32 (1.8 V)
and LDO33 (1.2 V). The SPI controller needs a feedback delay of 1 at
25 MHz, otherwise reads come back shifted. Headphones are on HPOUT2,
fed from AIF1, which is wired to ABOX UAIF0.

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 .../boot/dts/exynos/exynos8895-dream2lte.dts  | 89 +++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
index 1bdff0fb8..6a2898c82 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
@@ -121,6 +121,12 @@ gnss_if@ffc00000 {
 		};
 	};
 
+	sound {
+		compatible = "samsung,dream2lte-audio";
+		samsung,cpu = <&abox>;
+		samsung,codec = <&codec>;
+	};
+
 	sd_vmmc: regulator-sd-vmmc {
 		compatible = "regulator-fixed";
 		regulator-name = "sd-vmmc";
@@ -287,6 +293,10 @@ usb-crit {
 	};
 };
 
+&abox {
+	status = "okay";
+};
+
 &adc {
 	status = "okay";
 };
@@ -417,6 +427,70 @@ key_wink: key-wink-pins {
 	};
 };
 
+&spi_3 {
+	cs-gpios = <&gpd1 6 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&spi3_bus &spi3_cs>;
+
+	status = "okay";
+
+	codec: audio-codec@0 {
+		compatible = "cirrus,cs47l93";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+
+		interrupt-parent = <&gpa2>;
+		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		#sound-dai-cells = <1>;
+
+		pinctrl-0 = <&codec_pins>;
+		pinctrl-names = "default";
+
+		reset-gpios = <&gpe7 0 GPIO_ACTIVE_LOW>;
+
+		AVDD-supply = <&codec_vdd_1v8>;
+		DBVDD1-supply = <&codec_vdd_1v8>;
+		CPVDD1-supply = <&codec_vdd_1v8>;
+		CPVDD2-supply = <&codec_vdd_1v2>;
+		DCVDD-supply = <&codec_vdd_1v2>;
+
+		cirrus,inmode = <0 2 2 0 2 2 0 0>;
+		cirrus,out-mono = <0 0 0 1 0 0>;
+
+		controller-data {
+			samsung,spi-feedback-delay = <1>;
+		};
+
+		codec_pins: pin-settings {
+			aif1-pins {
+				groups = "aif1";
+				function = "aif1";
+				bias-bus-hold;
+			};
+
+			pdmspk1-pins {
+				groups = "pdmspk1";
+				function = "pdmspk1";
+			};
+
+			aif3-pins {
+				groups = "aif3";
+				function = "aif3";
+				bias-bus-hold;
+			};
+		};
+	};
+};
+
+&usi1 {
+	samsung,mode = <USI_MODE_SPI>;
+
+	status = "okay";
+};
+
 &usi9 {
 	samsung,mode = <USI_MODE_I2C0_1>;
 
@@ -456,6 +530,21 @@ sd_vqmmc: LDO2 {
 				regulator-max-microvolt = <3300000>;
 			};
 
+			codec_vdd_1v8: LDO32 {
+				regulator-name = "codec_1.8v";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+				regulator-boot-on;
+			};
+
+			codec_vdd_1v2: LDO33 {
+				regulator-name = "codec_1.2v";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+				regulator-enable-ramp-delay = <5000>;
+			};
+
 			tsp_io: LDO34 {
 				regulator-name = "tsp_io";
 				regulator-min-microvolt = <1850000>;
