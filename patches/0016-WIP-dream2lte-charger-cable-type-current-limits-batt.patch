+static int max77865_charger_set_property(struct power_supply *psy,
+					 enum power_supply_property psp,
+					 const union power_supply_propval *val)
+{
+	struct max77865_charger *chg = power_supply_get_drvdata(psy);
+	int ret;
+
+	mutex_lock(&chg->lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		if (val->intval < MAX77865_CHG_CHGIN_ILIM_MIN_UA) {
+			ret = -EINVAL;
+			goto out;
+		}
+		chg->user_input_limit = val->intval;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		if (val->intval < MAX77865_CHG_CC_MIN_UA) {
+			ret = -EINVAL;
+			goto out;
+		}
+		chg->user_cc = val->intval;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		if (val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+		    val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE) {
+			ret = -EINVAL;
+			goto out;
+		}
+		chg->inhibit = val->intval ==
+			       POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+		break;
+	default:
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = max77865_charger_apply(chg);
+out:
+	mutex_unlock(&chg->lock);
+
+	if (!ret)
+		power_supply_changed(psy);
+
+	return ret;
+}
