 /*
  * Charger of the Maxim MAX77865 PMIC (Samsung Galaxy S8/S8+)
  *
- * The charger runs autonomously with the settings left by the bootloader;
- * this driver only reports its state. It also routes the USB data lines to
- * the SoC with the MUIC of the same chip, which the bootloader leaves open.
+ * The input current limit and the charge current follow the charger type
+ * found by the BC1.2 detection of the MUIC in the same chip, with the
+ * values of the vendor kernel, and are reduced or charging is stopped
+ * outside the battery's temperature range (read from a thermal zone). The
+ * charger has a watchdog, enabled by the bootloader, that turns charging
+ * off unless it is cleared regularly: it is cleared from the poll work, so
+ * charging stops if the system stops running.
+ *
+ * The driver also routes the USB data lines to the SoC with the MUIC, which
+ * the bootloader leaves open. Adaptive fast charging (9 V) is not done.
  */
 
 #include <linux/bitfield.h>
 #include <linux/i2c.h>
+#include <linux/minmax.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/power_supply.h>
 #include <linux/regmap.h>
+#include <linux/thermal.h>
 #include <linux/workqueue.h>
 
 #define MAX77865_CHG_REG_DETAILS_00	0xb3
@@ -20,21 +30,83 @@
 #define MAX77865_CHGIN_VALID		0x3
 #define MAX77865_CHG_REG_DETAILS_01	0xb4
 #define MAX77865_CHG_DTLS		GENMASK(3, 0)
+#define MAX77865_CHG_REG_CNFG_00	0xb7
+#define MAX77865_CHG_CNFG_00_CHG	BIT(0)
+#define MAX77865_CHG_REG_CNFG_02	0xb9
+#define MAX77865_CHG_CC			GENMASK(5, 0)
+#define MAX77865_CHG_CC_STEP_UA		50000
+#define MAX77865_CHG_CC_MIN_UA		100000
+#define MAX77865_CHG_CC_MAX_UA		3150000
+#define MAX77865_CHG_REG_CNFG_03	0xba
+#define MAX77865_CHG_TO_ITH		GENMASK(2, 0)
+#define MAX77865_CHG_TO_ITH_MIN_UA	150000
+#define MAX77865_CHG_TO_ITH_STEP_UA	50000
+#define MAX77865_CHG_TO_ITH_MAX_UA	500000
+#define MAX77865_CHG_REG_CNFG_04	0xbb
+#define MAX77865_CHG_CV_PRM		GENMASK(5, 0)
+#define MAX77865_CHG_CV_MIN_UV		4050000
+#define MAX77865_CHG_CV_STEP_UV		12500
+#define MAX77865_CHG_CV_MAX_UV		4500000
+#define MAX77865_CHG_REG_CNFG_06	0xbd
+#define MAX77865_CHG_WDTCLR		GENMASK(1, 0)
+#define MAX77865_CHG_WDTCLR_CLEAR	0x1
+#define MAX77865_CHG_REG_CNFG_09	0xc0
+#define MAX77865_CHG_CHGIN_ILIM		GENMASK(6, 0)
+#define MAX77865_CHG_CHGIN_ILIM_STEP_UA	25000
+#define MAX77865_CHG_CHGIN_ILIM_MIN_UA	100000
+#define MAX77865_CHG_CHGIN_ILIM_MAX_UA	3175000
 
 #define MAX77865_MUIC_ADDR		0x25
+#define MAX77865_MUIC_REG_STATUS1_BC	0x0d
+#define MAX77865_MUIC_VBVOLT		BIT(7)
+#define MAX77865_MUIC_CHGDETRUN		BIT(6)
+#define MAX77865_MUIC_CHGTYP		GENMASK(1, 0)
+#define MAX77865_MUIC_CHGTYP_SDP	0x1
+#define MAX77865_MUIC_CHGTYP_CDP	0x2
+#define MAX77865_MUIC_CHGTYP_DCP	0x3
 #define MAX77865_MUIC_REG_CONTROL1	0x19
 /* D+ and D- to the AP USB PHY, ID open, BC comparator off */
 #define MAX77865_MUIC_COM_USB_AP	0x89
 
+/* the charger watchdog expires after about 95 s */
 #define MAX77865_POLL_INTERVAL		(5 * HZ)
 
+/* battery temperature ranges of the vendor kernel, in milli-Celsius */
+#define MAX77865_TEMP_COLD		0
+#define MAX77865_TEMP_COLD_RECOVER	5000
+#define MAX77865_TEMP_COOL		15000
+#define MAX77865_TEMP_COOL_RECOVER	20000
+#define MAX77865_TEMP_WARM		41000
+#define MAX77865_TEMP_WARM_RECOVER	39000
+#define MAX77865_TEMP_HOT		50000
+#define MAX77865_TEMP_HOT_RECOVER	45000
+#define MAX77865_COOL_CC_UA		800000
+#define MAX77865_WARM_CC_UA		1250000
+#define MAX77865_WARM_CV_UV		4150000
+/* without a battery temperature, charge as from a computer port */
+#define MAX77865_NO_TEMP_CC_UA		500000
+
 struct max77865_charger {
 	struct device *dev;
 	struct regmap *regmap;
+	struct regmap *muic;
 	struct power_supply *psy;
+	struct thermal_zone_device *battery_tz;
 	struct delayed_work poll;
-	int online;
+	/* protects everything below */
+	struct mutex lock;
+	enum power_supply_usb_type usb_type;
+	int health;
+	bool online;
 	int status;
+	bool inhibit;
+	int user_input_limit;
+	int user_cc;
+	int cc_max;
+	int cv_max;
+	int input_limit;
+	int cc;
+	int cv;
 };
 
 static const struct regmap_config max77865_regmap_config = {
@@ -43,104 +115,433 @@ static const struct regmap_config max77865_regmap_config = {
 	.max_register = 0xff,
 };
 
-static int max77865_charger_read(struct max77865_charger *chg, int *online,
-				 int *status)
+static int max77865_charger_status(struct max77865_charger *chg)
 {
-	unsigned int dtls0, dtls1;
+	unsigned int dtls;
 	int ret;
 
-	ret = regmap_read(chg->regmap, MAX77865_CHG_REG_DETAILS_00, &dtls0);
+	ret = regmap_read(chg->regmap, MAX77865_CHG_REG_DETAILS_01, &dtls);
 	if (ret)
 		return ret;
-	ret = regmap_read(chg->regmap, MAX77865_CHG_REG_DETAILS_01, &dtls1);
-	if (ret)
-		return ret;
-
-	*online = FIELD_GET(MAX77865_CHGIN_DTLS, dtls0) == MAX77865_CHGIN_VALID;
 
-	switch (FIELD_GET(MAX77865_CHG_DTLS, dtls1)) {
+	switch (FIELD_GET(MAX77865_CHG_DTLS, dtls)) {
 	case 0x0:	/* precharge */
 	case 0x1:	/* fast charge, constant current */
 	case 0x2:	/* fast charge, constant voltage */
-		*status = POWER_SUPPLY_STATUS_CHARGING;
-		break;
+		return POWER_SUPPLY_STATUS_CHARGING;
 	case 0x3:	/* top-off */
 	case 0x4:	/* done */
-		*status = POWER_SUPPLY_STATUS_FULL;
-		break;
+		return POWER_SUPPLY_STATUS_FULL;
+	case 0x8:	/* off: no valid input or charging disabled */
+		return chg->online ? POWER_SUPPLY_STATUS_NOT_CHARGING :
+				     POWER_SUPPLY_STATUS_DISCHARGING;
 	case 0x5:	/* timer fault */
 	case 0x6:	/* thermal suspend */
-	case 0x7:	/* charger off */
-		*status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+	case 0x7:	/* battery thermistor suspend */
+	case 0xa:	/* junction temperature shutdown */
+	case 0xb:	/* watchdog expired */
+		return POWER_SUPPLY_STATUS_NOT_CHARGING;
+	default:
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+	}
+}
+
+static int max77865_charger_charge_type(struct max77865_charger *chg,
+					int *type)
+{
+	unsigned int dtls;
+	int ret;
+
+	ret = regmap_read(chg->regmap, MAX77865_CHG_REG_DETAILS_01, &dtls);
+	if (ret)
+		return ret;
+
+	switch (FIELD_GET(MAX77865_CHG_DTLS, dtls)) {
+	case 0x0:
+		*type = POWER_SUPPLY_CHARGE_TYPE_TRICKLE;
 		break;
-	case 0x8:	/* no valid input */
-	case 0xa:
-	case 0xb:
-		*status = POWER_SUPPLY_STATUS_DISCHARGING;
+	case 0x1:
+	case 0x2:
+	case 0x3:
+		*type = POWER_SUPPLY_CHARGE_TYPE_FAST;
 		break;
 	default:
-		*status = POWER_SUPPLY_STATUS_UNKNOWN;
+		*type = POWER_SUPPLY_CHARGE_TYPE_NONE;
 		break;
 	}
 
 	return 0;
 }
 
+static enum power_supply_usb_type max77865_charger_detect(struct max77865_charger *chg,
+							  bool *online)
+{
+	unsigned int dtls, bc;
+
+	if (regmap_read(chg->regmap, MAX77865_CHG_REG_DETAILS_00, &dtls) ||
+	    regmap_read(chg->muic, MAX77865_MUIC_REG_STATUS1_BC, &bc)) {
+		*online = false;
+		return POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	}
+
+	*online = FIELD_GET(MAX77865_CHGIN_DTLS, dtls) == MAX77865_CHGIN_VALID;
+	if (!*online || !(bc & MAX77865_MUIC_VBVOLT) ||
+	    (bc & MAX77865_MUIC_CHGDETRUN))
+		return POWER_SUPPLY_USB_TYPE_UNKNOWN;
+
+	switch (FIELD_GET(MAX77865_MUIC_CHGTYP, bc)) {
+	case MAX77865_MUIC_CHGTYP_SDP:
+		return POWER_SUPPLY_USB_TYPE_SDP;
+	case MAX77865_MUIC_CHGTYP_CDP:
+		return POWER_SUPPLY_USB_TYPE_CDP;
+	case MAX77865_MUIC_CHGTYP_DCP:
+		return POWER_SUPPLY_USB_TYPE_DCP;
+	default:
+		return POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	}
+}
+
+/* input current limit and charge current for a charger type, in uA */
+static void max77865_charger_type_limits(enum power_supply_usb_type type,
+					 int *input_limit, int *cc)
+{
+	switch (type) {
+	case POWER_SUPPLY_USB_TYPE_CDP:
+		*input_limit = 1500000;
+		*cc = 1500000;
+		break;
+	case POWER_SUPPLY_USB_TYPE_DCP:
+		*input_limit = 1800000;
+		*cc = 2100000;
+		break;
+	case POWER_SUPPLY_USB_TYPE_SDP:
+	default:
+		*input_limit = 500000;
+		*cc = 500000;
+		break;
+	}
+}
+
+static const char *max77865_charger_health_name(int health)
+{
+	switch (health) {
+	case POWER_SUPPLY_HEALTH_COLD:
+		return "cold, charging stopped";
+	case POWER_SUPPLY_HEALTH_COOL:
+		return "cool, charge current reduced";
+	case POWER_SUPPLY_HEALTH_WARM:
+		return "warm, charge current and voltage reduced";
+	case POWER_SUPPLY_HEALTH_HOT:
+		return "hot, charging stopped";
+	default:
+		return "normal";
+	}
+}
+
+/* update the battery health from its temperature, with hysteresis */
+static void max77865_charger_update_health(struct max77865_charger *chg)
+{
+	int temp, health = chg->health;
+
+	if (!chg->battery_tz) {
+		chg->battery_tz = thermal_zone_get_zone_by_name("battery-thermal");
+		if (IS_ERR(chg->battery_tz))
+			chg->battery_tz = NULL;
+	}
+
+	if (!chg->battery_tz || thermal_zone_get_temp(chg->battery_tz, &temp)) {
+		chg->health = POWER_SUPPLY_HEALTH_UNKNOWN;
+		return;
+	}
+
+	switch (health) {
+	case POWER_SUPPLY_HEALTH_COLD:
+		if (temp >= MAX77865_TEMP_COLD_RECOVER)
+			health = POWER_SUPPLY_HEALTH_COOL;
+		break;
+	case POWER_SUPPLY_HEALTH_COOL:
+		if (temp < MAX77865_TEMP_COLD)
+			health = POWER_SUPPLY_HEALTH_COLD;
+		else if (temp >= MAX77865_TEMP_COOL_RECOVER)
+			health = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	case POWER_SUPPLY_HEALTH_WARM:
+		if (temp >= MAX77865_TEMP_HOT)
+			health = POWER_SUPPLY_HEALTH_HOT;
+		else if (temp < MAX77865_TEMP_WARM_RECOVER)
+			health = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	case POWER_SUPPLY_HEALTH_HOT:
+		if (temp < MAX77865_TEMP_HOT_RECOVER)
+			health = POWER_SUPPLY_HEALTH_WARM;
+		break;
+	default:
+		health = POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	}
+
+	/* a large jump moves past the hysteresis band */
+	if (temp < MAX77865_TEMP_COLD)
+		health = POWER_SUPPLY_HEALTH_COLD;
+	else if (temp >= MAX77865_TEMP_HOT)
+		health = POWER_SUPPLY_HEALTH_HOT;
+	else if (health == POWER_SUPPLY_HEALTH_GOOD && temp < MAX77865_TEMP_COOL)
+		health = POWER_SUPPLY_HEALTH_COOL;
+	else if (health == POWER_SUPPLY_HEALTH_GOOD && temp >= MAX77865_TEMP_WARM)
+		health = POWER_SUPPLY_HEALTH_WARM;
+
+	if (health != chg->health)
+		dev_info(chg->dev, "battery at %d.%d C: %s\n", temp / 1000,
+			 abs(temp % 1000) / 100,
+			 max77865_charger_health_name(health));
+	chg->health = health;
+}
+
+/* program the limits for the current charger type, health and user caps */
+static int max77865_charger_apply(struct max77865_charger *chg)
+{
+	int input_limit, cc, cv = chg->cv_max;
+	bool enable = !chg->inhibit;
+	unsigned int val;
+	int ret;
+
+	max77865_charger_type_limits(chg->usb_type, &input_limit, &cc);
+	input_limit = min(input_limit, chg->user_input_limit);
+	cc = min3(cc, chg->cc_max, chg->user_cc);
+
+	switch (chg->health) {
+	case POWER_SUPPLY_HEALTH_COLD:
+	case POWER_SUPPLY_HEALTH_HOT:
+		enable = false;
+		break;
+	case POWER_SUPPLY_HEALTH_COOL:
+		cc = min(cc, MAX77865_COOL_CC_UA);
+		break;
+	case POWER_SUPPLY_HEALTH_WARM:
+		cc = min(cc, MAX77865_WARM_CC_UA);
+		cv = min(cv, MAX77865_WARM_CV_UV);
+		break;
+	case POWER_SUPPLY_HEALTH_GOOD:
+		break;
+	default:
+		cc = min(cc, MAX77865_NO_TEMP_CC_UA);
+		break;
+	}
+
+	/* registers are only written when they differ */
+	val = clamp(input_limit, MAX77865_CHG_CHGIN_ILIM_MIN_UA,
+		    MAX77865_CHG_CHGIN_ILIM_MAX_UA) /
+	      MAX77865_CHG_CHGIN_ILIM_STEP_UA;
+	ret = regmap_update_bits(chg->regmap, MAX77865_CHG_REG_CNFG_09,
+				 MAX77865_CHG_CHGIN_ILIM, val);
+	if (ret)
+		return ret;
+	chg->input_limit = input_limit;
+
+	val = min(cc, MAX77865_CHG_CC_MAX_UA) / MAX77865_CHG_CC_STEP_UA;
+	ret = regmap_update_bits(chg->regmap, MAX77865_CHG_REG_CNFG_02,
+				 MAX77865_CHG_CC, val);
+	if (ret)
+		return ret;
+	chg->cc = cc;
