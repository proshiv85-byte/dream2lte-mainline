+static void max77865_charger_poll(struct work_struct *work)
+{
+	struct max77865_charger *chg = container_of(work, struct max77865_charger,
+						    poll.work);
+	enum power_supply_usb_type usb_type;
+	bool online, changed;
+	int health, status;
+
+	/* clear the charger watchdog */
+	regmap_write_bits(chg->regmap, MAX77865_CHG_REG_CNFG_06,
+			  MAX77865_CHG_WDTCLR, MAX77865_CHG_WDTCLR_CLEAR);
+
+	mutex_lock(&chg->lock);
+	usb_type = max77865_charger_detect(chg, &online);
+	health = chg->health;
+	max77865_charger_update_health(chg);
+
+	changed = usb_type != chg->usb_type || online != chg->online ||
+		  health != chg->health;
+	chg->usb_type = usb_type;
+	chg->online = online;
+	/* also restores the settings should the charger have reset them */
+	if (max77865_charger_apply(chg))
+		dev_err_ratelimited(chg->dev, "failed to set the charging limits\n");
+
+	status = max77865_charger_status(chg);
+	if (status != chg->status)
+		changed = true;
+	chg->status = status;
+	mutex_unlock(&chg->lock);
+
+	if (changed)
+		power_supply_changed(chg->psy);
+
+	schedule_delayed_work(&chg->poll, MAX77865_POLL_INTERVAL);
+}
