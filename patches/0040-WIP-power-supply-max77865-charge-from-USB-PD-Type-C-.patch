From 82573d8b3913db05c253a0f8aa7cb127418043f1 Mon Sep 17 00:00:00 2001
From: proshiv85-byte <proshiv85@gmail.com>
Date: Sun, 1 Nov 2026 09:47:04 +0200
Subject: [PATCH 40/41] WIP: power: supply: max77865: charge from USB PD,
 Type-C current and QC 2.0

Take the input limits from the Type-C controller (our supplier): a PD
contract replaces the BC1.2 values (charge current: input power at the
charge voltage, as the vendor kernel), Type-C 1.5 A / 3 A raise them.

On a DCP without PD, ask for 9 V with Quick Charge 2.0 through the MUIC
once per plug-in: D+ at 0.6 V for 1.5 s, then D+ 3.3 V / D- 0.6 V, and
check VBUS with the MUIC's ADC; then charge with the vendor's 9 V
limits (1.65 A in, 2.5 A). Go back to 5 V when VBUS leaves 9 V, the
battery is outside its normal temperature range, the fast_charge module
parameter is turned off, or at shutdown. The way back is a QC 5 V
request before the lines are released: a tested charger kept 9 V when
D+/D- were only released.

Also report the nominal input voltage in voltage_now, and take
supplier changes right away.

Assisted-by: Claude Opus 5.5 (Anthropic)
---
 drivers/power/supply/max77865_charger.c | 338 +++++++++++++++++++++++-
 1 file changed, 325 insertions(+), 13 deletions(-)

diff --git a/drivers/power/supply/max77865_charger.c b/drivers/power/supply/max77865_charger.c
index 98faaf08f..2146e249f 100644
--- a/drivers/power/supply/max77865_charger.c
+++ b/drivers/power/supply/max77865_charger.c
@@ -3,8 +3,10 @@
  * Charger of the Maxim MAX77865 PMIC (Samsung Galaxy S8/S8+)
  *
  * The input current limit and the charge current follow the charger type
- * found by the BC1.2 detection of the MUIC in the same chip, with the
- * values of the vendor kernel, and are reduced or charging is stopped
+ * found by the BC1.2 detection of the MUIC in the same chip and what the
+ * Type-C controller (our power supplier) reports: the source's Type-C
+ * current, or the USB PD contract (up to 9 V), with the values of the
+ * vendor kernel. They are reduced or charging is stopped
  * outside the battery's temperature range (read from a thermal zone). The
  * charger has a watchdog, enabled by the bootloader, that turns charging
  * off unless it is cleared regularly: it is cleared from the poll work, so
@@ -12,7 +14,14 @@
  *
  * The driver also routes the USB data lines to the SoC with the MUIC, which
  * the bootloader leaves open, and provides the 5 V boost on the USB port for
- * USB host mode as a regulator. Adaptive fast charging (9 V) is not done.
+ * USB host mode as a regulator.
+ *
+ * On a dedicated charging port without USB PD, the MUIC asks for 9 V with
+ * Quick Charge 2.0 (levels on D+/D-, as the vendor kernel does it): D+ at
+ * 0.6 V until the charger opens its D+/D- short, then D+ 3.3 V and D- 0.6 V.
+ * The VBUS ADC of the MUIC shows whether the charger followed. The way back
+ * is a QC 5 V request, then the lines are released. The fast_charge module
+ * parameter turns this off. Samsung's own AFC (a serial protocol on D-) is not done.
  */
 
 #include <linux/bitfield.h>
@@ -20,6 +29,7 @@
 #include <linux/i2c.h>
 #include <linux/minmax.h>
 #include <linux/module.h>
+#include <linux/moduleparam.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/power_supply.h>
@@ -74,9 +84,32 @@
 #define MAX77865_MUIC_CHGTYP_SDP	0x1
 #define MAX77865_MUIC_CHGTYP_CDP	0x2
 #define MAX77865_MUIC_CHGTYP_DCP	0x3
+#define MAX77865_MUIC_REG_STATUS_GP	0x0f
+#define MAX77865_MUIC_VBADC		GENMASK(3, 0)
+#define MAX77865_MUIC_VBADC_8V_9V	0x5
+#define MAX77865_MUIC_VBADC_9V_10V	0x6
+#define MAX77865_MUIC_REG_CONTROL2_BC	0x14
+#define MAX77865_MUIC_DNMONEN		BIT(5)
+#define MAX77865_MUIC_DPDNMAN		BIT(4)
+#define MAX77865_MUIC_DPDRV		GENMASK(3, 2)
+#define MAX77865_MUIC_DNDRV		GENMASK(1, 0)
+#define MAX77865_MUIC_DXDRV_0V6		0x1
+#define MAX77865_MUIC_DXDRV_3V3		0x2
 #define MAX77865_MUIC_REG_CONTROL1	0x19
 /* D+ and D- to the AP USB PHY, ID open, BC comparator off */
 #define MAX77865_MUIC_COM_USB_AP	0x89
+/* D+ and D- open (the AP's PHY off the lines while the MUIC drives them) */
+#define MAX77865_MUIC_COM_OPEN		0x80
+#define MAX77865_MUIC_REG_HVCONTROL1	0x1d
+#define MAX77865_MUIC_VBUSADCEN		BIT(0)
+
+/* QC 2.0: how long D+ stays at 0.6 V, and VBUS settling after the request */
+#define MAX77865_QC_PREPARE_MS		1500
+#define MAX77865_QC_SETTLE_MS		1000
+#define MAX77865_QC_5V_MS		500
+/* 9 V charger limits of the vendor kernel */
+#define MAX77865_QC_9V_INPUT_UA		1650000
+#define MAX77865_QC_9V_CC_UA		2500000
 
 /* the charger watchdog expires after about 95 s */
 #define MAX77865_POLL_INTERVAL		(5 * HZ)
@@ -95,6 +128,19 @@
 #define MAX77865_WARM_CV_UV		4150000
 /* without a battery temperature, charge as from a computer port */
 #define MAX77865_NO_TEMP_CC_UA		500000
+/* Type-C current advertisements of the source (5 V) */
+#define MAX77865_TYPEC_1500MA		1500000
+#define MAX77865_TYPEC_3000MA		3000000
+
+static bool fast_charge = true;
+module_param(fast_charge, bool, 0644);
+MODULE_PARM_DESC(fast_charge, "ask chargers for 9 V with Quick Charge 2.0 (default: on)");
+
+enum max77865_qc_state {
+	MAX77865_QC_IDLE,	/* nothing tried on this charger yet */
+	MAX77865_QC_9V,		/* charger at 9 V */
+	MAX77865_QC_FAILED,	/* not a QC charger, or it dropped out */
+};
 
 struct max77865_charger {
 	struct device *dev;
@@ -106,6 +152,10 @@ struct max77865_charger {
 	/* protects everything below */
 	struct mutex lock;
 	enum power_supply_usb_type usb_type;
+	/* what the Type-C controller reports: C, PD or UNKNOWN (nothing) */
+	enum power_supply_usb_type src_type;
+	int src_uv;
+	int src_ua;
 	int health;
 	bool online;
 	int status;
@@ -117,6 +167,11 @@ struct max77865_charger {
 	int input_limit;
 	int cc;
 	int cv;
+	/* the type the limits come from, as reported in usb_type */
+	enum power_supply_usb_type eff_type;
+	enum max77865_qc_state qc;
+	/* polls in a row that saw a DCP, to give USB PD time to come first */
+	unsigned int dcp_polls;
 };
 
 static const struct regmap_config max77865_regmap_config = {
@@ -211,7 +266,7 @@ static enum power_supply_usb_type max77865_charger_detect(struct max77865_charge
 	}
 }
 
-/* input current limit and charge current for a charger type, in uA */
+/* input current limit and charge current for a BC1.2 charger type, in uA */
 static void max77865_charger_type_limits(enum power_supply_usb_type type,
 					 int *input_limit, int *cc)
 {
@@ -232,6 +287,78 @@ static void max77865_charger_type_limits(enum power_supply_usb_type type,
 	}
 }
 
+/*
+ * Input current limit and charge current for what the charger offers, in uA.
+ * A PD contract (which may be above 5 V) replaces the BC1.2 values; the
+ * Type-C current at 5 V only raises them. Like the vendor kernel, the charge
+ * current for PD is the input power at the battery's charge voltage (the
+ * battery's maximum still applies).
+ */
+static enum power_supply_usb_type
+max77865_charger_limits(struct max77865_charger *chg, int *input_limit, int *cc)
+{
+	max77865_charger_type_limits(chg->usb_type, input_limit, cc);
+
+	if (chg->qc == MAX77865_QC_9V) {
+		*input_limit = MAX77865_QC_9V_INPUT_UA;
+		*cc = MAX77865_QC_9V_CC_UA;
+		return chg->usb_type;
+	}
+
+	if (chg->src_type == POWER_SUPPLY_USB_TYPE_PD && chg->src_ua > 0) {
+		*input_limit = chg->src_ua;
+		*cc = div_u64((u64)chg->src_uv * chg->src_ua, chg->cv_max);
+		return POWER_SUPPLY_USB_TYPE_PD;
+	}
+
+	if (chg->src_type == POWER_SUPPLY_USB_TYPE_C) {
+		if (chg->src_ua >= MAX77865_TYPEC_3000MA) {
+			if (*input_limit >= MAX77865_TYPEC_3000MA)
+				return chg->usb_type;
+			*input_limit = MAX77865_TYPEC_3000MA;
+			*cc = INT_MAX;
+			return POWER_SUPPLY_USB_TYPE_C;
+		}
+		if (chg->src_ua >= MAX77865_TYPEC_1500MA &&
+		    *input_limit < MAX77865_TYPEC_1500MA) {
+			*input_limit = MAX77865_TYPEC_1500MA;
+			*cc = max(*cc, MAX77865_TYPEC_1500MA);
+			return POWER_SUPPLY_USB_TYPE_C;
+		}
+	}
+
+	return chg->usb_type;
+}
+
+/* read what the Type-C controller reports, without our lock */
+static void max77865_charger_get_source(struct max77865_charger *chg,
+					enum power_supply_usb_type *type,
+					int *uv, int *ua)
+{
+	struct power_supply *psy = chg->psy;
+	union power_supply_propval val;
+
+	*type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	*uv = 0;
+	*ua = 0;
+
+	if (power_supply_get_property_from_supplier(psy, POWER_SUPPLY_PROP_ONLINE,
+						    &val) || !val.intval)
+		return;
+	if (power_supply_get_property_from_supplier(psy, POWER_SUPPLY_PROP_USB_TYPE,
+						    &val))
+		return;
+	*type = val.intval;
+	if (!power_supply_get_property_from_supplier(psy,
+						     POWER_SUPPLY_PROP_VOLTAGE_NOW,
+						     &val))
+		*uv = val.intval;
+	if (!power_supply_get_property_from_supplier(psy,
+						     POWER_SUPPLY_PROP_CURRENT_MAX,
+						     &val))
+		*ua = val.intval;
+}
+
 static const char *max77865_charger_health_name(int health)
 {
 	switch (health) {
@@ -315,7 +442,7 @@ static int max77865_charger_apply(struct max77865_charger *chg)
 	unsigned int val;
 	int ret;
 
-	max77865_charger_type_limits(chg->usb_type, &input_limit, &cc);
+	chg->eff_type = max77865_charger_limits(chg, &input_limit, &cc);
 	input_limit = min(input_limit, chg->user_input_limit);
 	cc = min3(cc, chg->cc_max, chg->user_cc);
 
@@ -368,37 +495,177 @@ static int max77865_charger_apply(struct max77865_charger *chg)
 				  enable ? MAX77865_CHG_CNFG_00_CHG : 0);
 }
 
+static int max77865_qc_vbadc(struct max77865_charger *chg)
+{
+	unsigned int gp;
+	int ret;
+
+	ret = regmap_read(chg->muic, MAX77865_MUIC_REG_STATUS_GP, &gp);
+	if (ret)
+		return ret;
+
+	return FIELD_GET(MAX77865_MUIC_VBADC, gp);
+}
+
+static bool max77865_qc_vbus_is_9v(struct max77865_charger *chg)
+{
+	int vbadc = max77865_qc_vbadc(chg);
+
+	return vbadc == MAX77865_MUIC_VBADC_8V_9V ||
+	       vbadc == MAX77865_MUIC_VBADC_9V_10V;
+}
+
+/*
+ * Back to 5 V and release D+/D-, USB to the AP again. Some chargers keep
+ * 9 V when the lines are just released, so 5 V (D+ 0.6 V, D- 0 V) is
+ * requested first when the charger is still there.
+ */
+static void max77865_qc_release(struct max77865_charger *chg, bool request_5v)
+{
+	if (request_5v &&
+	    !regmap_write(chg->muic, MAX77865_MUIC_REG_CONTROL2_BC,
+			  MAX77865_MUIC_DPDNMAN |
+			  FIELD_PREP(MAX77865_MUIC_DPDRV, MAX77865_MUIC_DXDRV_0V6)))
+		msleep(MAX77865_QC_5V_MS);
+
+	regmap_write(chg->muic, MAX77865_MUIC_REG_CONTROL2_BC, 0);
+	regmap_write(chg->muic, MAX77865_MUIC_REG_HVCONTROL1, 0);
+	regmap_write(chg->muic, MAX77865_MUIC_REG_CONTROL1,
+		     MAX77865_MUIC_COM_USB_AP);
+}
+
+/* the QC 2.0 handshake, sleeps for about 2.5 s; true if VBUS is at 9 V */
+static bool max77865_qc_request_9v(struct max77865_charger *chg)
+{
+	int ret;
+
+	ret = regmap_write(chg->muic, MAX77865_MUIC_REG_CONTROL1,
+			   MAX77865_MUIC_COM_OPEN);
+	if (!ret)
+		ret = regmap_write(chg->muic, MAX77865_MUIC_REG_HVCONTROL1,
+				   MAX77865_MUIC_VBUSADCEN);
+	if (!ret)
+		ret = regmap_write(chg->muic, MAX77865_MUIC_REG_CONTROL2_BC,
+				   MAX77865_MUIC_DNMONEN | MAX77865_MUIC_DPDNMAN |
+				   FIELD_PREP(MAX77865_MUIC_DPDRV,
+					      MAX77865_MUIC_DXDRV_0V6));
+	if (ret)
+		goto fail;
+
+	msleep(MAX77865_QC_PREPARE_MS);
+
+	ret = regmap_write(chg->muic, MAX77865_MUIC_REG_CONTROL2_BC,
+			   MAX77865_MUIC_DPDNMAN |
+			   FIELD_PREP(MAX77865_MUIC_DPDRV, MAX77865_MUIC_DXDRV_3V3) |
+			   FIELD_PREP(MAX77865_MUIC_DNDRV, MAX77865_MUIC_DXDRV_0V6));
+	if (ret)
+		goto fail;
+
+	msleep(MAX77865_QC_SETTLE_MS);
+
+	if (max77865_qc_vbus_is_9v(chg))
+		return true;
+
+fail:
+	max77865_qc_release(chg, true);
+	return false;
+}
+
 static void max77865_charger_poll(struct work_struct *work)
 {
 	struct max77865_charger *chg = container_of(work, struct max77865_charger,
 						    poll.work);
-	enum power_supply_usb_type usb_type;
-	bool online, changed;
-	int health, status;
+	enum power_supply_usb_type usb_type, src_type, eff_type;
+	bool online, changed, try_qc = false;
+	int health, status, src_uv, src_ua;
 
 	/* clear the charger watchdog */
 	regmap_write_bits(chg->regmap, MAX77865_CHG_REG_CNFG_06,
 			  MAX77865_CHG_WDTCLR, MAX77865_CHG_WDTCLR_CLEAR);
 
+	max77865_charger_get_source(chg, &src_type, &src_uv, &src_ua);
+
 	mutex_lock(&chg->lock);
 	usb_type = max77865_charger_detect(chg, &online);
 	health = chg->health;
+	eff_type = chg->eff_type;
 	max77865_charger_update_health(chg);
 
+	if (src_type != chg->src_type || src_uv != chg->src_uv ||
+	    src_ua != chg->src_ua)
+		dev_info(chg->dev, "source: %s, %d mV, %d mA\n",
+			 src_type == POWER_SUPPLY_USB_TYPE_PD ? "USB PD" :
+			 src_type == POWER_SUPPLY_USB_TYPE_C ? "Type-C" : "none",
+			 src_uv / 1000, src_ua / 1000);
+
 	changed = usb_type != chg->usb_type || online != chg->online ||
-		  health != chg->health;
+		  health != chg->health || src_type != chg->src_type ||
+		  src_uv != chg->src_uv || src_ua != chg->src_ua;
 	chg->usb_type = usb_type;
 	chg->online = online;
+	chg->src_type = src_type;
+	chg->src_uv = src_uv;
+	chg->src_ua = src_ua;
+
+	/*
+	 * QC 2.0 once per plug-in, on a DCP without PD or Type-C current,
+	 * at a normal battery temperature. Drop back to 5 V if VBUS leaves
+	 * 9 V, the battery gets too warm or cold, or it is turned off.
+	 */
+	if (!online || usb_type != POWER_SUPPLY_USB_TYPE_DCP) {
+		if (chg->qc == MAX77865_QC_9V)
+			max77865_qc_release(chg, online);
+		if (!online)
+			chg->qc = MAX77865_QC_IDLE;
+		else if (chg->qc == MAX77865_QC_9V)
+			chg->qc = MAX77865_QC_FAILED;
+		chg->dcp_polls = 0;
+	} else if (chg->qc == MAX77865_QC_9V) {
+		if (!fast_charge || chg->health != POWER_SUPPLY_HEALTH_GOOD ||
+		    src_type == POWER_SUPPLY_USB_TYPE_PD ||
+		    !max77865_qc_vbus_is_9v(chg)) {
+			dev_info(chg->dev, "QC 2.0: back to 5 V\n");
+			max77865_qc_release(chg, true);
+			/* a turned-off fast_charge may be turned on again */
+			chg->qc = fast_charge && chg->health ==
+				  POWER_SUPPLY_HEALTH_GOOD ?
+				  MAX77865_QC_FAILED : MAX77865_QC_IDLE;
+			changed = true;
+		}
+	} else if (chg->qc == MAX77865_QC_IDLE && fast_charge &&
+		   chg->health == POWER_SUPPLY_HEALTH_GOOD &&
+		   src_type != POWER_SUPPLY_USB_TYPE_PD &&
+		   src_ua < MAX77865_TYPEC_1500MA) {
+		try_qc = ++chg->dcp_polls >= 2;
+	}
+
 	/* also restores the settings should the charger have reset them */
 	if (max77865_charger_apply(chg))
 		dev_err_ratelimited(chg->dev, "failed to set the charging limits\n");
 
+	if (chg->eff_type != eff_type)
+		changed = true;
 	status = max77865_charger_status(chg);
 	if (status != chg->status)
 		changed = true;
 	chg->status = status;
 	mutex_unlock(&chg->lock);
 
+	if (try_qc) {
+		bool ok = max77865_qc_request_9v(chg);
+
+		mutex_lock(&chg->lock);
+		/* unplugged meanwhile: the next poll cleans up */
+		chg->qc = ok ? MAX77865_QC_9V : MAX77865_QC_FAILED;
+		dev_info(chg->dev, "QC 2.0: %s\n",
+			 ok ? "charger at 9 V" : "no 9 V, staying at 5 V");
+		if (max77865_charger_apply(chg))
+			dev_err_ratelimited(chg->dev,
+					    "failed to set the charging limits\n");
+		mutex_unlock(&chg->lock);
+		changed = true;
+	}
+
 	if (changed)
 		power_supply_changed(chg->psy);
 
@@ -431,11 +698,23 @@ static int max77865_charger_get_property(struct power_supply *psy,
 		val->intval = chg->health;
 		break;
 	case POWER_SUPPLY_PROP_USB_TYPE:
-		val->intval = chg->usb_type;
+		val->intval = chg->online ? chg->eff_type :
+			      POWER_SUPPLY_USB_TYPE_UNKNOWN;
 		break;
 	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
 		val->intval = chg->input_limit;
 		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		/* the charger's nominal output voltage */
+		if (!chg->online)
+			val->intval = 0;
+		else if (chg->qc == MAX77865_QC_9V)
+			val->intval = 9000000;
+		else if (chg->eff_type == POWER_SUPPLY_USB_TYPE_PD)
+			val->intval = chg->src_uv;
+		else
+			val->intval = 5000000;
+		break;
 	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
 		val->intval = chg->cc;
 		break;
@@ -522,6 +801,14 @@ static int max77865_charger_property_is_writeable(struct power_supply *psy,
 	}
 }
 
+/* the Type-C controller has news: take it now instead of at the next poll */
+static void max77865_charger_external_power_changed(struct power_supply *psy)
+{
+	struct max77865_charger *chg = power_supply_get_drvdata(psy);
+
+	mod_delayed_work(system_percpu_wq, &chg->poll, 0);
+}
+
 static const enum power_supply_property max77865_charger_props[] = {
 	POWER_SUPPLY_PROP_ONLINE,
 	POWER_SUPPLY_PROP_STATUS,
@@ -529,6 +816,7 @@ static const enum power_supply_property max77865_charger_props[] = {
 	POWER_SUPPLY_PROP_HEALTH,
 	POWER_SUPPLY_PROP_USB_TYPE,
 	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
 	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
 	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
 	POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
@@ -542,7 +830,9 @@ static const struct power_supply_desc max77865_charger_desc = {
 	.usb_types	= BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN) |
 			  BIT(POWER_SUPPLY_USB_TYPE_SDP) |
 			  BIT(POWER_SUPPLY_USB_TYPE_CDP) |
-			  BIT(POWER_SUPPLY_USB_TYPE_DCP),
+			  BIT(POWER_SUPPLY_USB_TYPE_DCP) |
+			  BIT(POWER_SUPPLY_USB_TYPE_C) |
+			  BIT(POWER_SUPPLY_USB_TYPE_PD),
 	.charge_behaviours = BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) |
 			     BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE),
 	.properties	= max77865_charger_props,
@@ -550,6 +840,7 @@ static const struct power_supply_desc max77865_charger_desc = {
 	.get_property	= max77865_charger_get_property,
 	.set_property	= max77865_charger_set_property,
 	.property_is_writeable = max77865_charger_property_is_writeable,
+	.external_power_changed = max77865_charger_external_power_changed,
 };
 
 /*
@@ -635,7 +926,7 @@ static void max77865_charger_stop_poll(void *data)
 {
 	struct max77865_charger *chg = data;
 
-	cancel_delayed_work_sync(&chg->poll);
+	disable_delayed_work_sync(&chg->poll);
 }
 
 static int max77865_muic_init(struct max77865_charger *chg,
@@ -728,6 +1019,12 @@ static int max77865_charger_probe(struct i2c_client *client)
 	chg->online = true;
 	chg->user_input_limit = INT_MAX;
 	chg->user_cc = INT_MAX;
+	chg->src_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	chg->eff_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+
+	/* the supplier may call external_power_changed once we are registered */
+	INIT_DELAYED_WORK(&chg->poll, max77865_charger_poll);
+	disable_delayed_work(&chg->poll);
 
