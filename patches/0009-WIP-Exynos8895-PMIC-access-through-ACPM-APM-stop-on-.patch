 enum {
@@ -40,13 +46,20 @@ enum {
 struct s2mps17_rtc {
 	struct regmap *regmap;
 	struct rtc_device *rtc;
+	/* UPDATE register without the request bits */
+	unsigned int update_base;
 };
 
 static int s2mps17_rtc_update(struct s2mps17_rtc *info, unsigned int bit)
 {
 	int ret;
 
-	ret = regmap_update_bits(info->regmap, S2MPS17_RTC_REG_UPDATE, bit, bit);
+	/*
+	 * Write the whole register: a request bit that still reads as set
+	 * from the previous request would not trigger a new transfer.
+	 */
+	ret = regmap_write(info->regmap, S2MPS17_RTC_REG_UPDATE,
+			   info->update_base | bit);
 	if (ret)
 		return ret;
 
@@ -147,6 +160,12 @@ static int s2mps17_rtc_probe(struct i2c_client *client)
 		return dev_err_probe(dev, -ENODEV,
 				     "unsupported counter mode %#x\n", ctrl);
 
+	ret = regmap_read(info->regmap, S2MPS17_RTC_REG_UPDATE,
+			  &info->update_base);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read update\n");
+	info->update_base &= ~S2MPS17_RTC_UPDATE_REQS;
+
 	dev_set_drvdata(dev, info);
 
 	info->rtc = devm_rtc_allocate_device(dev);
