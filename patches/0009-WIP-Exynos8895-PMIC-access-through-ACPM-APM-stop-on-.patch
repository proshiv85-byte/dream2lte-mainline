diff --git a/drivers/i2c/busses/i2c-exynos-acpm-pmic.c b/drivers/i2c/busses/i2c-exynos-acpm-pmic.c
new file mode 100644
index 000000000..0d3e4daa4
--- /dev/null
+++ b/drivers/i2c/busses/i2c-exynos-acpm-pmic.c
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PMIC access through the Exynos ACPM firmware, as an I2C adapter
+ *
+ * On Exynos8895 the PMIC sits on the SPEEDY bus, which the APM firmware
+ * also drives itself to change the CPU and GPU voltages. The host must not
+ * touch the SPEEDY controller then; the firmware performs the transfers on
+ * its behalf. This adapter maps I2C register transfers (one register byte
+ * followed by data) onto ACPM PMIC commands, the client address selects the
+ * PMIC block (the "type" of the command).
+ */
+
+#include <linux/err.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define ACPM_PMIC_BULK_MAX	8
+
+struct acpm_pmic_i2c {
+	struct i2c_adapter adap;
+	struct acpm_handle *handle;
+	u32 chan_id;
+};
+
+static int acpm_pmic_i2c_read(struct acpm_pmic_i2c *bus, u8 type, u8 reg,
+			      u8 *buf, u16 len)
+{
+	const struct acpm_pmic_ops *ops = &bus->handle->ops->pmic;
+	int ret;
+	u8 n;
+
+	while (len) {
+		n = min_t(u16, len, ACPM_PMIC_BULK_MAX);
+		if (n == 1)
+			ret = ops->read_reg(bus->handle, bus->chan_id, type,
+					    reg, 0, buf);
+		else
+			ret = ops->bulk_read(bus->handle, bus->chan_id, type,
+					     reg, 0, n, buf);
+		if (ret)
+			return ret;
+
+		reg += n;
+		buf += n;
+		len -= n;
+	}
+
+	return 0;
+}
+
+static int acpm_pmic_i2c_write(struct acpm_pmic_i2c *bus, u8 type, u8 reg,
+			       const u8 *buf, u16 len)
+{
+	const struct acpm_pmic_ops *ops = &bus->handle->ops->pmic;
+	int ret;
+	u8 n;
+
+	while (len) {
+		n = min_t(u16, len, ACPM_PMIC_BULK_MAX);
+		if (n == 1)
+			ret = ops->write_reg(bus->handle, bus->chan_id, type,
+					     reg, 0, *buf);
+		else
+			ret = ops->bulk_write(bus->handle, bus->chan_id, type,
+					      reg, 0, n, buf);
+		if (ret)
+			return ret;
+
+		reg += n;
+		buf += n;
+		len -= n;
+	}
+
+	return 0;
+}
+
+static int acpm_pmic_i2c_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+			      int num)
+{
+	struct acpm_pmic_i2c *bus = i2c_get_adapdata(adap);
+	struct i2c_msg *m = &msgs[0];
+	int ret;
+
+	/* register address, then data to write or a read of the data */
+	if (m->flags & I2C_M_RD || m->len < 1 || m->addr > 0xf)
+		return -EOPNOTSUPP;
+
+	if (num == 1) {
+		ret = acpm_pmic_i2c_write(bus, m->addr, m->buf[0], &m->buf[1],
+					  m->len - 1);
+	} else if (num == 2 && m->len == 1 && msgs[1].flags & I2C_M_RD &&
+		   msgs[1].addr == m->addr) {
+		ret = acpm_pmic_i2c_read(bus, m->addr, m->buf[0], msgs[1].buf,
+					 msgs[1].len);
+	} else {
+		return -EOPNOTSUPP;
+	}
+
+	return ret ? ret : num;
+}
+
+static u32 acpm_pmic_i2c_func(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_I2C | I2C_FUNC_SMBUS_BYTE_DATA |
+	       I2C_FUNC_SMBUS_I2C_BLOCK;
+}
+
+static const struct i2c_algorithm acpm_pmic_i2c_algo = {
+	.xfer = acpm_pmic_i2c_xfer,
+	.functionality = acpm_pmic_i2c_func,
+};
+
+static int acpm_pmic_i2c_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct acpm_pmic_i2c *bus;
+
+	bus = devm_kzalloc(dev, sizeof(*bus), GFP_KERNEL);
+	if (!bus)
+		return -ENOMEM;
+
+	bus->handle = devm_acpm_get_by_node(dev, dev->parent->of_node);
+	if (IS_ERR(bus->handle))
+		return dev_err_probe(dev, PTR_ERR(bus->handle),
+				     "failed to get ACPM handle\n");
+
+	if (of_property_read_u32(dev->of_node, "samsung,acpm-channel",
+				 &bus->chan_id))
+		return dev_err_probe(dev, -EINVAL, "no ACPM channel\n");
+
+	bus->adap.owner = THIS_MODULE;
+	bus->adap.algo = &acpm_pmic_i2c_algo;
+	bus->adap.dev.parent = dev;
+	bus->adap.dev.of_node = dev->of_node;
+	strscpy(bus->adap.name, "ACPM PMIC", sizeof(bus->adap.name));
+	i2c_set_adapdata(&bus->adap, bus);
+
+	return devm_i2c_add_adapter(dev, &bus->adap);
+}
+
+static const struct of_device_id acpm_pmic_i2c_of_match[] = {
+	{ .compatible = "samsung,exynos8895-acpm-pmic-i2c" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, acpm_pmic_i2c_of_match);
+
+static struct platform_driver acpm_pmic_i2c_driver = {
+	.probe = acpm_pmic_i2c_probe,
+	.driver = {
+		.name = "exynos-acpm-pmic-i2c",
+		.of_match_table = acpm_pmic_i2c_of_match,
+	},
+};
+module_platform_driver(acpm_pmic_i2c_driver);
+
+MODULE_DESCRIPTION("PMIC access through Exynos ACPM as an I2C adapter");
+MODULE_LICENSE("GPL");
diff --git a/drivers/rtc/rtc-s2mps17.c b/drivers/rtc/rtc-s2mps17.c
