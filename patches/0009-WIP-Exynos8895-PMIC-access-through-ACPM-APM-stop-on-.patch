 #define S2MPS17_RTC_UPDATE_RUDR		BIT(0)
 #define S2MPS17_RTC_UPDATE_WUDR		BIT(1)
+#define S2MPS17_RTC_UPDATE_FREEZE	BIT(2)
+#define S2MPS17_RTC_UPDATE_AUDR		BIT(4)
+#define S2MPS17_RTC_UPDATE_REQS		(S2MPS17_RTC_UPDATE_RUDR | \
+					 S2MPS17_RTC_UPDATE_WUDR | \
+					 S2MPS17_RTC_UPDATE_FREEZE | \
+					 S2MPS17_RTC_UPDATE_AUDR)
