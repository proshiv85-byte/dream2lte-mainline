 	return 0;
 }
 
+/**
+ * acpm_restart() - stop the APM before the system reset.
+ * @data:	sys-off data, cb_data is the driver data.
+ *
+ * Runs with interrupts off and the other CPUs stopped, so the command is
+ * sent and polled for without taking the channel locks.
+ *
+ * Return: NOTIFY_DONE, the reset itself is done by the next handler.
+ */
+static int acpm_restart(struct sys_off_data *data)
+{
+	struct acpm_info *acpm = data->cb_data;
+	struct acpm_chan *achan = &acpm->chans[acpm->ctrl_chan_id];
+	struct exynos_mbox_msg msg = {
+		.chan_id = acpm->ctrl_chan_id,
+		.chan_type = EXYNOS_MBOX_CHAN_TYPE_DOORBELL,
+	};
+	u32 cmd[4] = { ACPM_PROTOCOL_STOP |
+		       FIELD_PREP(ACPM_PROTOCOL_SEQNUM, ACPM_SEQNUM_MAX - 1) };
+	u32 tx_front, rx_rear, val;
+	int ret;
+
+
+	tx_front = readl(achan->tx.front);
+	rx_rear = readl(achan->rx.rear);
+	__iowrite32_copy(achan->tx.base + achan->mlen * tx_front, cmd,
+			 ARRAY_SIZE(cmd));
+	writel((tx_front + 1) % achan->qlen, achan->tx.front);
+
+	if (mbox_send_message(achan->chan, &msg) < 0)
+		return NOTIFY_DONE;
+	mbox_client_txdone(achan->chan, 0);
+
+	ret = readl_poll_timeout_atomic(achan->rx.front, val, val != rx_rear,
+					10, 100 * USEC_PER_MSEC);
+	writel(readl(achan->rx.front), achan->rx.rear);
+	if (ret)
+		pr_emerg("acpm: APM did not acknowledge stop\n");
+
+	regmap_clear_bits(acpm->pmu, ACPM_PMU_APM_CONFIGURATION,
+			  ACPM_PMU_APM_LOCAL_PWR_CFG);
+
+	return NOTIFY_DONE;
+}
+
 static void acpm_clk_pdev_unregister(void *data)
 {
 	platform_device_unregister(data);
@@ -889,6 +949,23 @@ static int acpm_probe(struct platform_device *pdev)
 
 	acpm->handle.ops = &exynos_acpm_driver_ops;
 
