+		acpm->ctrl_chan_id = match_data->plugin_chan_id;
+		/* before syscon-reboot, which writes SWRESET */
+		ret = devm_register_sys_off_handler(dev, SYS_OFF_MODE_RESTART,
+						    SYS_OFF_PRIO_FIRMWARE,
+						    acpm_restart, acpm);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to register restart handler\n");
+	}
+
 	if (match_data->plugin_chan_id >= 0) {
 		ret = acpm_plugins_init(acpm, match_data->plugin_chan_id);
 		if (ret)
@@ -1041,6 +1118,7 @@ static const struct acpm_match_data acpm_exynos8895 = {
