+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lte.dts
@@ -193,6 +193,12 @@ fuel-gauge@36 {
 		compatible = "maxim,max17050";
 		reg = <0x36>;
 		maxim,rsns-microohm = <10000>;
+		power-supplies = <&charger>;
+	};
+
+	charger: charger@69 {
+		compatible = "maxim,max77865-charger";
+		reg = <0x69>;
 	};
 };
 
@@ -309,6 +315,13 @@ reboot: syscon-reboot {
 		value = <0x1>;
 	};
 
+	poweroff: syscon-poweroff {
+		compatible = "syscon-poweroff";
+		offset = <0x330c>; /* PS_HOLD_CONTROL */
+		mask = <0x100>;
+		value = <0x0>;
+	};
+
 	/* S-Boot reads the reboot reason from INFORM3 */
 	reboot-mode {
 		compatible = "syscon-reboot-mode";
