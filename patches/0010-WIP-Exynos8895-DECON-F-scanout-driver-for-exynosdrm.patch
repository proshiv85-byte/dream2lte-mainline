diff --git a/drivers/gpu/drm/exynos/exynos_drm_fb.c b/drivers/gpu/drm/exynos/exynos_drm_fb.c
index 4cff2b2b6..e233c653d 100644
--- a/drivers/gpu/drm/exynos/exynos_drm_fb.c
+++ b/drivers/gpu/drm/exynos/exynos_drm_fb.c
@@ -8,6 +8,8 @@
  *	Seung-Woo Kim <sw0312.kim@samsung.com>
  */
 
+#include <linux/dma-mapping.h>
+
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_crtc.h>
@@ -43,8 +45,15 @@ static int check_fb_gem_memory_type(struct drm_device *drm_dev,
 	 * supported without IOMMU.
 	 */
 	if (IS_NONCONTIG_BUFFER(flags)) {
-		DRM_DEV_ERROR(drm_dev->dev,
-			      "Non-contiguous GEM memory is not supported.\n");
+		DRM_DEV_DEBUG_KMS(drm_dev->dev,
+				  "Non-contiguous GEM memory is not supported.\n");
+		return -EINVAL;
+	}
+
+	/* the display DMA only takes 32-bit addresses */
+	if (exynos_gem->dma_addr + exynos_gem->base.size - 1 > DMA_BIT_MASK(32)) {
+		DRM_DEV_DEBUG_KMS(drm_dev->dev,
+				  "GEM memory above 4 GiB is not supported.\n");
 		return -EINVAL;
 	}
 
diff --git a/drivers/gpu/drm/exynos/exynos_drm_gem.c b/drivers/gpu/drm/exynos/exynos_drm_gem.c
index 0208c9259..b4e2d322a 100644
--- a/drivers/gpu/drm/exynos/exynos_drm_gem.c
+++ b/drivers/gpu/drm/exynos/exynos_drm_gem.c
@@ -427,17 +427,25 @@ exynos_drm_gem_prime_import_sg_table(struct drm_device *dev,
 				     struct sg_table *sgt)
 {
 	struct exynos_drm_gem *exynos_gem;
+	bool contig;
 
-	/* check if the entries in the sg_table are contiguous */
-	if (drm_prime_get_contiguous_size(sgt) < attach->dmabuf->size) {
-		DRM_ERROR("buffer chunks must be mapped contiguously");
-		return ERR_PTR(-EINVAL);
-	}
