diff --git a/exynos_heap.c b/exynos_heap.c
new file mode 100644
index 0000000..570e367
--- /dev/null
+++ b/exynos_heap.c
@@ -0,0 +1,257 @@
+/*
+ * exynos (Exynos8895 DECON-F, dream2lte): scanout buffers as exynos-drm dumb
+ * buffers, everything else from the dma-buf system heap.
+ *
+ * This DECON has no IOMMU, so exynos-drm buffers come from CMA, which is far
+ * too small for all of Android's buffers. Only the client composition target
+ * (GRALLOC_USAGE_HW_FB, see cros_gralloc_helpers.cc) is scanned out; every
+ * other buffer only needs to be imported by the GPU (panfrost), which takes
+ * scattered memory. Heap buffers are handled by a dma-heap sub-driver, so
+ * their fd handles never mix with exynos GEM handles.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "drv_helpers.h"
+#include "drv_priv.h"
+#include "external/dma-buf.h"
+#include "external/dma-heap.h"
+#include "util.h"
+
+#define EXYNOS_HEAP_PATH "/dev/dma_heap/system"
+
+static const uint32_t render_formats[] = { DRM_FORMAT_ARGB8888, DRM_FORMAT_XRGB8888,
+					   DRM_FORMAT_ABGR8888, DRM_FORMAT_XBGR8888,
+					   DRM_FORMAT_BGR888,	DRM_FORMAT_RGB565,
+					   DRM_FORMAT_ABGR2101010, DRM_FORMAT_ABGR16161616F };
+
+static const uint32_t texture_formats[] = { DRM_FORMAT_R8, DRM_FORMAT_NV12, DRM_FORMAT_NV21,
+					    DRM_FORMAT_YVU420, DRM_FORMAT_YVU420_ANDROID };
+
+/* ---- dma-heap sub-driver: images of any of the formats above ---- */
+
+static int heap_bo_compute_metadata(struct bo *bo, uint32_t width, uint32_t height,
+				    uint32_t format, uint64_t use_flags, const uint64_t *modifiers,
+				    uint32_t count)
+{
+	uint32_t stride = drv_stride_from_format(format, width, 0);
+
+	/* the same alignment panfrost and the display use for linear buffers */
+	return drv_bo_from_format(bo, ALIGN(stride, 64), 1, ALIGN(height, 4), format);
+}
+
+static int heap_bo_create_from_metadata(struct bo *bo)
+{
+	struct dma_heap_allocation_data args = {
+		.len = bo->meta.total_size,
+		.fd_flags = O_RDWR | O_CLOEXEC,
+	};
+
+	if (ioctl(bo->drv->fd, DMA_HEAP_IOCTL_ALLOC, &args))
+		return -errno;
+
+	bo->handle.fd = args.fd;
+	return 0;
+}
+
+static int heap_bo_destroy(struct bo *bo)
+{
+	return close(bo->handle.fd);
+}
+
+static int heap_bo_import(struct bo *bo, struct drv_import_fd_data *data)
+{
+	int fd;
+
+	/* all planes in one buffer, as gralloc hands them out */
+	for (size_t p = 1; p < bo->meta.num_planes; p++)
+		if (data->fds[p] != data->fds[0])
+			return -EINVAL;
+
+	fd = dup(data->fds[0]);
+	if (fd < 0)
+		return -errno;
+
+	bo->handle.fd = fd;
+	return 0;
+}
+
+static int heap_bo_export(struct bo *bo, size_t plane)
+{
+	int fd = dup(bo->handle.fd);
+
+	return fd >= 0 ? fd : -errno;
+}
+
+static void *heap_bo_map(struct bo *bo, struct vma *vma, uint32_t map_flags)
+{
+	vma->length = bo->meta.total_size;
+	return mmap(NULL, vma->length, drv_get_prot(map_flags), MAP_SHARED, bo->handle.fd, 0);
+}
+
+static int heap_bo_sync(struct bo *bo, bool start, uint32_t map_flags)
+{
+	struct dma_buf_sync args = { .flags = start ? DMA_BUF_SYNC_START : DMA_BUF_SYNC_END };
+
+	if (map_flags & BO_MAP_READ)
+		args.flags |= DMA_BUF_SYNC_READ;
+	if (map_flags & BO_MAP_WRITE)
+		args.flags |= DMA_BUF_SYNC_WRITE;
+
+	return ioctl(bo->handle.fd, DMA_BUF_IOCTL_SYNC, &args) ? -errno : 0;
+}
+
+static int heap_bo_invalidate(struct bo *bo, struct mapping *mapping)
+{
+	return heap_bo_sync(bo, true, mapping->vma->map_flags);
+}
+
+static int heap_bo_flush(struct bo *bo, struct mapping *mapping)
+{
+	return heap_bo_sync(bo, false, mapping->vma->map_flags);
+}
+
+static int heap_init(struct driver *drv)
+{
+	return 0;
+}
+
+static const struct backend backend_exynos_heap = {
+	.name = "exynos_heap",
+	.init = heap_init,
+	.bo_compute_metadata = heap_bo_compute_metadata,
+	.bo_create_from_metadata = heap_bo_create_from_metadata,
+	.bo_destroy = heap_bo_destroy,
+	.bo_import = heap_bo_import,
+	.bo_export = heap_bo_export,
+	.bo_map = heap_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.bo_invalidate = heap_bo_invalidate,
+	.bo_flush = heap_bo_flush,
+	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
+};
+
+/* ---- exynos-drm main driver ---- */
+
+struct exynos_priv {
+	bool tried_heap;
+	int heap_fd;
+	struct driver *heap;
+};
+
+static bool forward_to_heap(struct bo *bo)
+{
+	struct exynos_priv *priv = bo->drv->priv;
+
+	if (!priv->tried_heap) {
+		priv->tried_heap = true;
+		priv->heap_fd = open(EXYNOS_HEAP_PATH, O_RDONLY | O_CLOEXEC);
+		if (priv->heap_fd >= 0) {
+			priv->heap = drv_create(priv->heap_fd, &backend_exynos_heap);
+			if (!priv->heap) {
+				close(priv->heap_fd);
+				priv->heap_fd = -1;
+			}
+		}
+		if (!priv->heap)
+			drv_loge("no %s, all buffers from exynos-drm (CMA)\n", EXYNOS_HEAP_PATH);
+	}
+	if (!priv->heap)
+		return false;
+
+	bo->drv = priv->heap;
+	return true;
+}
+
+static int exynos_init(struct driver *drv)
+{
+	struct exynos_priv *priv = calloc(1, sizeof(*priv));
+
+	if (!priv)
+		return -ENOMEM;
+	priv->heap_fd = -1;
+	drv->priv = priv;
+
+	drv_add_combinations(drv, render_formats, ARRAY_SIZE(render_formats), &LINEAR_METADATA,
+			     BO_USE_RENDER_MASK | BO_USE_SCANOUT);
+	drv_add_combinations(drv, texture_formats, ARRAY_SIZE(texture_formats), &LINEAR_METADATA,
+			     BO_USE_TEXTURE_MASK);
+	drv_modify_combination(drv, DRM_FORMAT_R8, &LINEAR_METADATA,
+			       BO_USE_HW_VIDEO_ENCODER | BO_USE_HW_VIDEO_DECODER |
+				   BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE |
+				   BO_USE_GPU_DATA_BUFFER | BO_USE_SENSOR_DIRECT_DATA);
+	drv_modify_combination(drv, DRM_FORMAT_NV12, &LINEAR_METADATA,
+			       BO_USE_HW_VIDEO_ENCODER | BO_USE_HW_VIDEO_DECODER |
+				   BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE);
+
+	return drv_modify_linear_combinations(drv);
+}
+
+static void exynos_close(struct driver *drv)
+{
+	struct exynos_priv *priv = drv->priv;
+
+	if (priv->heap) {
+		drv_destroy(priv->heap);
+		close(priv->heap_fd);
+	}
+	free(priv);
+	drv->priv = NULL;
+}
+
+static int exynos_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
+			    uint64_t use_flags)
+{
+	if (!(use_flags & (BO_USE_SCANOUT | BO_USE_CURSOR)) && forward_to_heap(bo)) {
+		int ret = bo->drv->backend->bo_compute_metadata(bo, width, height, format,
+								use_flags, NULL, 0);
+		return ret ? ret : bo->drv->backend->bo_create_from_metadata(bo);
+	}
+
+	return drv_dumb_bo_create(bo, width, height, format, use_flags);
+}
+
+static int exynos_bo_create_with_modifiers(struct bo *bo, uint32_t width, uint32_t height,
+					   uint32_t format, const uint64_t *modifiers,
+					   uint32_t count)
+{
+	for (uint32_t i = 0; i < count; i++)
+		if (modifiers[i] == DRM_FORMAT_MOD_LINEAR)
+			return exynos_bo_create(bo, width, height, format, bo->meta.use_flags);
+
+	return -EINVAL;
+}
+
+static int exynos_bo_import(struct bo *bo, struct drv_import_fd_data *data)
+{
+	/*
+	 * Only scanout buffers need an exynos-drm GEM object. Everything else is
+	 * kept as a plain dma-buf: an imported GEM object can't be mapped like a
+	 * dumb buffer, while any dma-buf (heap or exynos-drm) maps through its fd.
+	 */
+	if (data->use_flags & (BO_USE_SCANOUT | BO_USE_CURSOR))
+		return drv_prime_bo_import(bo, data);
+
+	if (!forward_to_heap(bo))
+		return drv_prime_bo_import(bo, data);
+	return bo->drv->backend->bo_import(bo, data);
+}
+
+const struct backend backend_exynos = {
+	.name = "exynos",
+	.init = exynos_init,
+	.close = exynos_close,
+	.bo_create = exynos_bo_create,
+	.bo_create_with_modifiers = exynos_bo_create_with_modifiers,
+	.bo_destroy = drv_dumb_bo_destroy,
+	.bo_import = exynos_bo_import,
+	.bo_export = drv_prime_bo_export,
+	.bo_map = drv_dumb_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
+};
