 		     BO_USE_SCANOUT | BO_USE_TEXTURE);
+#endif
 #ifdef DRMHWC_ON_VIRTGPU
 	handle_usage(&usage, GRALLOC_USAGE_HW_FB, &use_flags, BO_USE_LINEAR);
 #else
