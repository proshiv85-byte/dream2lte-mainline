# Theme "dusk" (minimal: dark grays, one muted peach accent): sway part.
# Installed by armtix-theme, included from ~/.config/sway/config.
# palette: bg #111013  surface #19181c  line #2a282e  dim #5d5a63
#          muted #8e8a94  text #d9d5dd  bright #f0edf2  accent #d9a48f
output $out bg ~/.config/sway/wallpaper.png fill #111013
font pango:JetBrains Mono 8
default_border pixel 1
default_floating_border pixel 1
titlebar_padding 8 3
titlebar_border_thickness 0
title_align left
gaps inner 3
gaps outer 0
hide_edge_borders none
#                       border  bg      text    indicator child_border
client.focused          #d9a48f #19181c #f0edf2 #d9a48f   #d9a48f
client.focused_inactive #2a282e #141316 #8e8a94 #2a282e   #2a282e
client.unfocused        #1c1b1f #111013 #5d5a63 #1c1b1f   #1c1b1f
client.urgent           #d07a7a #2a1a1a #f0edf2 #d07a7a   #d07a7a
client.background       #111013
