# ~/.bashrc: interactive shells (foot). Minimal prompt in the dusk colors.
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias ll='ls -lh --color=auto'
alias grep='grep --color=auto'
HISTSIZE=5000
HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize

__dusk_prompt() {
	local s=$? c='\[\e[38;2;93;90;99m\]'
	[ $s -ne 0 ] && c='\[\e[38;2;208;122;122m\]'
	PS1='\[\e[38;2;142;138;148m\]\w '"$c"'›\[\e[0m\] '
}
PROMPT_COMMAND=__dusk_prompt
