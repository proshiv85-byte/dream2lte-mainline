// Theme "dusk", minimal: a flat status line on top, a flat row of
// touch buttons at the bottom.
[
{
	"name": "status",
	"layer": "top",
	"position": "top",
	"height": 24,
	"spacing": 0,
	"modules-left": ["sway/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["network", "pulseaudio", "custom/brightness", "custom/battery"],

	"sway/workspaces": {
		"format": "{name}",
		"disable-scroll": true
	},
	"clock": {
		"format": "{:%H:%M}",
		"format-alt": "{:%a %d %b}",
		"tooltip": false
	},
	"network": {
		"interface": "wlan0",
		"format": "󰤮",
		"format-wifi": "{icon}",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"format-disconnected": "󰤮",
		"format-disabled": "󰤮",
		"tooltip-format-wifi": "{essid} {signalStrength}%\n{ipaddr}",
		"on-click": "armtix-wifi"
	},
	"pulseaudio": {
		"format": "{icon}",
		"format-muted": "󰖁",
		"format-icons": ["󰕿", "󰖀", "󰕾"],
		"tooltip-format": "volume {volume}%",
		"on-click": "armtix-volume mute",
		"on-scroll-up": "armtix-volume up",
		"on-scroll-down": "armtix-volume down"
	},
	// waybar's backlight module finds no device with libudev-zero
	"custom/brightness": {
		"exec": "armtix-brightness status",
		"return-type": "json",
		"interval": 30,
		"signal": 8,
		"on-click": "armtix-brightness cycle",
		"on-scroll-up": "armtix-brightness up",
		"on-scroll-down": "armtix-brightness down"
	},
	"custom/battery": {
		"exec": "armtix-battery",
		"return-type": "json",
		"interval": 20
	}
},
{
	"name": "dock",
	"layer": "top",
	"position": "bottom",
	"height": 38,
	"spacing": 0,
	"modules-center": ["custom/apps", "custom/keyboard", "custom/rotate", "custom/close", "custom/power"],

	"custom/apps":     { "format": "󰀻", "tooltip": false, "on-click": "fuzzel" },
	"custom/keyboard": { "format": "󰌌", "tooltip": false, "on-click": "armtix-osk toggle" },
	"custom/rotate":   { "format": "󰑵", "tooltip": false, "on-click": "armtix-rotate next" },
	"custom/close":    { "format": "󰅖", "tooltip": false, "on-click": "swaymsg kill" },
	"custom/power":    { "format": "󰐥", "tooltip": false, "on-click": "armtix-power-menu" }
}
]
