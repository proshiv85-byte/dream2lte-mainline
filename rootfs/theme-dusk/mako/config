# Notifications, dusk theme
font=JetBrains Mono 9
background-color=#0f0c18eb
text-color=#e4def0
border-color=#b4a4f2
border-size=2
border-radius=14
padding=12
margin=10
outer-margin=40,0,0,0
width=320
max-icon-size=36
icon-location=left
progress-color=over #3b3456
default-timeout=4000
anchor=top-center
format=<b>%s</b>\n%b

[urgency=low]
border-color=#3b3456

[urgency=high]
border-color=#e8758f
default-timeout=0
