#!/bin/sh
# waybar battery (custom module, JSON). Reads the battery's power supply
# directly: "battery" on the 4.4 kernel, the fuel gauge on mainline.
mode=$1
B=/sys/class/power_supply/battery
if [ ! -d "$B" ]; then
	for p in /sys/class/power_supply/*; do
		[ "$(cat "$p/type" 2>/dev/null)" = Battery ] && { B=$p; break; }
	done
fi
c=$(cat "$B/capacity" 2>/dev/null || echo 0)
s=$(cat "$B/status" 2>/dev/null || echo Unknown)
# on mainline the charger knows best whether it is charging
for p in /sys/class/power_supply/*; do
	[ "$(cat "$p/online" 2>/dev/null)" = 1 ] &&
		[ "$(cat "$p/type" 2>/dev/null)" != Battery ] &&
		{ cs=$(cat "$p/status" 2>/dev/null); [ -n "$cs" ] && s=$cs; }
done
set -- 󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹
i=$((c / 10 + 1)); [ $i -gt 11 ] && i=11
eval icon=\${$i}
class=normal
case $s in
	Charging) class=charging; icon=󰂄 ;;
	Full) class=full; icon=󰂅 ;;
	*) [ "$c" -le 10 ] && class=critical || { [ "$c" -le 20 ] && class=low; } ;;
esac
# `armtix-battery plain`: text instead of an icon (minimal theme)
if [ "$mode" = plain ]; then
	t="bat: $c%"
	[ "$s" = Charging ] && t="bat: $c%+"
else
	t="$icon $c%"
fi
printf '{"text":"%s","class":"%s","tooltip":"Battery %s%% (%s)"}\n' "$t" "$class" "$c" "$s"
